        rep = next((p for p in P if p["collection"] == c["key"] and p["thumb"]), None)
        tiles += f'''<li class="card" data-reveal style="--rd:{i}"><a href="/playgrounds/?c={c["key"]}#range" data-coll-link="{c["key"]}">
