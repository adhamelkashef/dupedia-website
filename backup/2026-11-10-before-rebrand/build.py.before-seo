    chips = f'<button type="button" class="chip" data-coll="" aria-pressed="true">All <span class="n">{COUNT}</span></button>' + "".join(
        f'<button type="button" class="chip" data-coll="{c["key"]}" aria-pressed="false">{e(c["short"])} <span class="n">{CCOUNT[c["key"]]}</span></button>' for c in COLL)
    ages = '<option value="">Any age</option>' + "".join(f'<option value="{a}">{a} years</option>' for a in range(1, 13))
    cards = "\n".join(product_card(p) for p in P)
    body = phero("Outdoor playgrounds · " + f"{COUNT} products · {len(COLL)} collections",
                 "Playground equipment|you can <em>plan</em> with.",
                 "Wooden play structures, climbing and agility, early-years playhouses and site furniture, made by Soliwood in Cairo and supplied and installed by Dupedia. Every product lists its code, size, platform height, age range and safety zone.",
                 crumbs=[("Home", "/"), ("Playgrounds", "/playgrounds/")],
                 actions=f'<a class="btn" href="#range">Browse the range {ARROW}</a><a class="link" href="/downloads/dupedia-playground-catalogue.pdf">{ic("download","ic ic-s")} Catalogue (PDF, 7&nbsp;MB)</a>') + f'''
<section class="sec-tight" aria-label="Collections" style="padding-top:0">
  <div class="wrap"><ul class="grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr))">{tiles}</ul></div>
</section>
<section id="range" data-range aria-labelledby="range-t">
  <h2 class="sr" id="range-t">All products</h2>
  <div class="filters">
    <div class="wrap filters-in">
      <div class="chips" role="group" aria-label="Collection">{chips}</div>
      <div class="fctl">
        <label class="fin"><span>Space</span><input id="r-l" type="number" inputmode="decimal" min="1" max="200" step="0.5" placeholder="L" aria-label="Space length in metres"><span>×</span><input id="r-w" type="number" inputmode="decimal" min="1" max="200" step="0.5" placeholder="W" aria-label="Space width in metres"><span>m</span></label>
        <label class="fin"><span class="sr">Children’s age</span><select id="r-age">{ages}</select></label>
        <label class="toggle"><input id="r-fit" type="checkbox"><span class="tg" aria-hidden="true"></span>Only what fits</label>
        <label class="fin"><span class="sr">Search by name or code</span><input id="r-q" type="search" placeholder="Search name or code" autocomplete="off"></label>
        <label class="fin"><span class="sr">Sort</span><select id="r-sort"><option value="coll">By collection</option><option value="small">Smallest safety zone</option><option value="large">Largest safety zone</option></select></label>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="results-line"><p id="r-count" aria-live="polite">{COUNT} products</p><a class="link" href="/contact/">Send us your site plan {ARROW}</a></div>
    <div class="coll-intro" id="r-note" hidden></div>
    <ul class="grid" id="grid">{cards}</ul>
    <div class="empty" id="r-empty" hidden>
      {block_band([("sq","c"),("qt","l"),("ci","c")])}
      <p class="h3">Nothing matches <em>yet.</em></p>
      <p class="muted">Try a larger space, another age, or clear the filters. Or send us your plan and we will look at it with you.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><button type="button" class="btn btn-ghost" id="r-reset">Clear filters</button><a class="btn" href="/contact/">Send us your plan</a></div>
    </div>
    <p class="source-note" style="margin-block:40px 96px">Products manufactured by Soliwood, Cairo. Codes, sizes, safety zones and ages are shown exactly as published by the manufacturer (October 2026). Products marked “zone set in your layout” have no fixed published zone; it is set when we draw your plan. Images are manufacturer product visuals.</p>
  </div>
</section>
{cta_band()}'''
    ld = [{"@type": "CollectionPage", "name": "Outdoor playground equipment", "url": BASE + "/playgrounds/", "isPartOf": {"@id": BASE + "/#web"},
           "mainEntity": {"@type": "ItemList", "numberOfItems": COUNT, "itemListElement": [{"@type": "ListItem", "position": i + 1, "url": BASE + p["url"], "name": p["name"]} for i, p in enumerate(P)]}}]
    page("/playgrounds/", f"Outdoor playground equipment in Egypt · {COUNT} wooden products",
         f"Wooden playground equipment for compounds, schools, hotels and parks in Egypt: {COUNT} products in {len(COLL)} collections, each with dimensions, age range and safety zone. Filter by the space you have.",
         body, active="/playgrounds/", ld=ld, catalog=True, crumbs=[("Home", "/"), ("Playgrounds", "/playgrounds/")])

def build_products():
    for i, p in enumerate(P):
        c = CBY[p["collection"]]; code_l = p["code"].lower()
        if p["img"]:
            media = f'<div class="pd-media mask-bl"><img src="{p["img"]}" srcset="{p["thumb"]} 560w, {p["img"]} 1100w" sizes="(max-width: 960px) 92vw, 56vw" width="1100" height="700" fetchpriority="high" decoding="async" alt="{e(p["name"])} ({p["code"]}), {e(c["short"].lower())} collection, product visual" style="view-transition-name:pv-{code_l}"></div><figcaption class="pd-cap">Product visual · {p["code"]}</figcaption>'
        else:
            media = '<div class="pd-media mask-bl"><span class="noimg">Photograph to follow</span></div>'
        z = zone_of(p)
        zone_txt = nb(p["safetyZone"]) if z[0] != "plan" else f'{nb(p["safetyZone"])}'
        spec = f'''<dl class="spec">
  <div>{ic("dim")}<dt>Dimensions</dt><dd>{nb(p["dimensions"])}</dd></div>
  <div>{ic("plat")}<dt>Platform height</dt><dd>{nb(p.get("platform") or "—")}</dd></div>
  <div>{ic("zone")}<dt>Safety zone</dt><dd>{zone_txt}</dd></div>
  <div>{ic("users")}<dt>Age range</dt><dd>{e(p["age"])}</dd></div>
</dl>'''
        inc = "".join(f"<li>{e(x)}</li>" for x in p.get("contents") or [])
        fins = "".join(f'<li><i style="background:{f["hex"]}" aria-hidden="true"></i><b>{e(f["name"])}</b><span>{e(f["desc"])}</span></li>' for f in FIN)
        same = [q for q in P if q["collection"] == p["collection"] and q["code"] != p["code"]][:4]
        prev, nxt = P[i - 1], P[(i + 1) % len(P)]
        zl = {"rect": "the published safety zone", "area": "the safety zone, published as an area", "plan": "a zone set in your layout"}[z[0]]
        quote_url = f'/contact/?type={quote("Outdoor playground")}'
        body = f'''<section class="sec-tight" style="padding-top:clamp(24px,4vw,56px)">
  <div class="wrap">
    <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/playgrounds/">Playgrounds</a></li><li><a href="/playgrounds/?c={c["key"]}#range">{e(c["short"])}</a></li><li aria-current="page">{e(p["name"])}</li></ol></nav>
    <div class="pd-hero">
      <figure class="pd-fig">{media}{'<span class="tag">New 2026</span>' if p.get("isNew") else ""}</figure>
      <div class="pd-info">
        <p class="pd-kicker"><span class="code">{p["code"]}</span><span class="ddot">{e(c["name"])}</span></p>
        <h1 class="h2">{e(p["name"])}</h1>
        <p class="muted">{e(p["description"])}</p>
        {spec}
        <div class="pd-act">
          <button type="button" class="btn" data-sl="{p["code"]}" data-name="{e(p["name"])}" aria-pressed="false">{ic("plus","ic ic-s")} <span class="t">Add to shortlist</span></button>
          <a class="btn btn-ghost" href="{quote_url}">Request a quote</a>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="sec-tight">
  <div class="wrap pd-body">
    <div>
      <h2 class="h3">What’s <em>included</em></h2>
      {f'<ul class="inc">{inc}</ul>' if inc else '<p class="muted" style="margin-top:16px">Component list on request.</p>'}
      <h2 class="h4" style="margin-top:48px">Seven finishes</h2>
      <ul class="finishes">{fins}</ul>
      <p class="source-note" style="margin-top:14px">Colours are indicative. Ask for a physical sample before ordering.</p>
    </div>
    <div class="fp" data-fp="{p["code"]}">
      <h2 class="h4">Will it fit your space?</h2>
      <p class="muted" style="font-size:15px">Enter your space. We check the product against {zl}, in either orientation.</p>
      <div class="fp-check">
        <label class="fin"><span>Space</span><input id="fp-l" type="number" inputmode="decimal" min="1" max="200" step="0.5" placeholder="L" aria-label="Space length in metres"><span>×</span><input id="fp-w" type="number" inputmode="decimal" min="1" max="200" step="0.5" placeholder="W" aria-label="Space width in metres"><span>m</span></label>
      </div>
      <p class="fp-res" aria-live="polite"></p>
      <svg role="img" aria-label="Footprint and safety zone of {e(p["name"])}, drawn to scale" viewBox="0 0 400 300"></svg>
      <div class="plan-key"><span><i class="k-site"></i>Your space</span><span><i class="k-zone"></i>Safety zone</span><span><i class="k-prod"></i>Footprint</span></div>
      <p class="fit-note">Geometry check against the published figures, not a safety certification.</p>
    </div>
  </div>
</section>
<section class="sec-tight">
  <div class="wrap">
    <p class="source-note">Manufactured by Soliwood, Cairo. Code, dimensions, platform height, safety zone and age range exactly as published by the manufacturer (October 2026). If a figure is missing, we confirm it in writing; we never estimate it.</p>
    <div class="sec-head" style="margin-top:72px;margin-bottom:32px"><h2 class="h3">More from {e(c["name"])}</h2><a class="link" href="/playgrounds/?c={c["key"]}#range">All {CCOUNT[c["key"]]} {ARROW}</a></div>
    <ul class="grid">{"".join(product_card(q) for q in same)}</ul>
    <nav class="pd-pager" aria-label="Other products" style="margin-top:56px">
      <a href="{prev["url"]}"><span class="code">Previous · {prev["code"]}</span><span class="nm">{e(prev["name"])}</span></a>
      <a href="{nxt["url"]}"><span class="code">Next · {nxt["code"]}</span><span class="nm">{e(nxt["name"])}</span></a>
    </nav>
  </div>
</section>
{cta_band(title=f"Planning with the <em>{e(p['name'])}?</em>", text="Send us your site plan or rough measurements. Add it to your shortlist and it travels with your request.")}'''
        props = [("Dimensions", p["dimensions"]), ("Platform height", p.get("platform")), ("Safety zone", p["safetyZone"]), ("Age range", p["age"])]
        prod = {"@type": "Product", "name": p["name"], "sku": p["code"], "mpn": p["code"], "description": p["description"], "url": BASE + p["url"],
                "category": f'Outdoor playground equipment > {c["name"]}',
                "manufacturer": {"@type": "Organization", "name": "Soliwood"},
                "additionalProperty": [{"@type": "PropertyValue", "name": n, "value": v} for n, v in props if v]}
        if p["img"]: prod["image"] = BASE + p["img"]
        desc = f'{p["name"]} ({p["code"]}): {p["dimensions"]}, safety zone {p["safetyZone"]}, ages {p["age"]}. {c["short"]} collection wooden playground equipment, supplied and installed in Egypt by Dupedia.'
        page(p["url"], f'{p["name"]} ({p["code"]}) · Dupedia playgrounds', desc[:300], body, active="/playgrounds/", ld=[prod], catalog=True,
             og_image=p["img"], crumbs=[("Home", "/"), ("Playgrounds", "/playgrounds/"), (p["name"], p["url"])])

def build_divisions():
    secs = ""
    for k, anchor, name, text, col, fg, cells, ptype in DIVISIONS:
        who = [s for s in SECTORS if (k == "play" and s[3]) or (k == "soft" and s[0] in ("malls", "hotels", "operators")) or (k == "arcade" and s[0] in ("malls", "operators")) or (k == "water" and s[0] in ("hotels", "developers", "operators")) or (k == "amuse" and s[0] in ("operators", "municipalities", "malls"))]
        need = {
            "play": ["Site plan or yard dimensions", "Age groups and how many play at once", "Products you are considering, if any"],
            "soft": ["Floor plan with ceiling height", "Age groups and expected visitors at once", "Opening date"],
            "arcade": ["Venue floor plan", "The audience and the mix you have in mind", "Opening date"],
            "water": ["Site plan and the water area you have in mind", "Who will use it and how many at once", "Season or opening date"],
            "amuse": ["Site or venue plan", "The kind of rides or attractions you have in mind", "Opening date and budget range, if known"],
        }[k]
        if k == "play":
            status = f'<p class="ddot" style="--c:{col}">{COUNT} products, fully specified</p>'
            act = f'<a class="btn" href="/playgrounds/">Browse the range {ARROW}</a><a class="link" href="/#fit">Check what fits your space {ARROW}</a>'
            media = f'<figure class="dsec-photo mask-bl">{div_img(k, "(max-width:860px) 92vw, 54vw")}</figure>'
        else:
            status = f'<p class="ddot" style="--c:{col}">Range on request</p>'
            label = {"soft": "a soft play", "arcade": "an arcade", "water": "a water park", "amuse": "an amusement"}[k]
            act = f'<a class="btn" href="/contact/?type={quote(ptype)}">Discuss {label} project {ARROW}</a>'
            media = f'<figure class="dsec-photo mask-bl">{div_img(k, "(max-width:860px) 92vw, 54vw")}</figure>'
        secs += f'''<section class="dsec" id="{anchor}" aria-labelledby="d-{anchor}">
  <div class="dsec-side" data-reveal>{mark(k)}<h2 class="h2" id="d-{anchor}">{name}</h2>{status}</div>
  <div data-reveal style="--rd:1">
    <p class="lede">{text}</p>
    <div class="split" style="margin-top:32px;gap:32px">
      <div><h3 class="h4">Usually for</h3><ul class="plain" style="margin-top:12px;display:grid;gap:8px">{"".join(f'<li><a class="link-plain" href="/who-we-work-with/#{s[0]}">{s[1]}</a></li>' for s in who)}</ul></div>
      <div><h3 class="h4">To quote, send us</h3><ul class="checklist" style="margin-top:4px">{"".join(f"<li><span>{x}</span></li>" for x in need)}</ul></div>
    </div>
    {media}
    <div class="phero-act">{act}</div>
  </div>
</section>'''
    body = phero("What we build", "Five kinds of place|to <em>play.</em>",
                 "Outdoor playgrounds, indoor and soft play, arcades, water parks and amusement attractions. One team from the first sketch to installation.",
                 crumbs=[("Home", "/"), ("What we build", "/what-we-build/")],
                 actions="".join(f'<a class="chip" style="text-decoration:none" href="#{a}"><span class="ddot" style="--c:{col}"></span>{n}</a>' for k, a, n, t, col, *_ in DIVISIONS)) + f'''
<div class="wrap">{secs}</div>
{cta_band()}'''
    ld = [{"@type": "Service", "name": strip(n), "serviceType": strip(n), "description": t, "provider": {"@id": BASE + "/#org"},
           "areaServed": [{"@type": "Country", "name": c} for c in CFG.get("serviceArea", [])], "url": BASE + f"/what-we-build/#{a}"} for k, a, n, t, *_ in DIVISIONS]
    page("/what-we-build/", "Playgrounds, soft play, arcades, water parks and amusement",
         "What Dupedia builds in Egypt: outdoor playgrounds, indoor and soft play, arcade and FEC fit-outs, water parks and amusement attractions, from first sketch to installation.",
         body, active="/what-we-build/", ld=ld, crumbs=[("Home", "/"), ("What we build", "/what-we-build/")])

def strip(s): return html.unescape(re.sub(r"<[^>]+>", "", s))

def build_sectors():
    secs = ""
    for i, (sid, name, short, colls, role, long, need) in enumerate(SECTORS):
        start = "".join(f'<a class="chip" style="text-decoration:none" href="/playgrounds/?c={c}#range">{e(CBY[c]["short"])} <span class="n">{CCOUNT[c]}</span></a>' for c in colls) \
            if colls else '<a class="chip" style="text-decoration:none" href="/what-we-build/#soft-play">Indoor &amp; soft play</a><a class="chip" style="text-decoration:none" href="/what-we-build/#arcades">Arcades &amp; games</a>'
        secs += f'''<section class="dsec" id="{sid}" aria-labelledby="s-{sid}">
  <div class="dsec-side" data-reveal><p class="code">{i + 1:02d}</p><h2 class="h2" id="s-{sid}">{name}</h2><p class="muted">{short}</p></div>
  <div data-reveal style="--rd:1">
    <p class="lede">{long}</p>
    <h3 class="h4" style="margin-top:32px">Start with</h3><div class="seg" style="margin-top:12px">{start}</div>
    <h3 class="h4" style="margin-top:32px">What helps us quote quickly</h3>
    <ul class="checklist" style="margin-top:4px">{"".join(f"<li><span>{x}</span></li>" for x in need)}</ul>
    <div class="phero-act"><a class="btn" href="/contact/?sector={quote(role)}">Discuss your project {ARROW}</a></div>
  </div>
</section>'''
    consult = f'''<section class="sec band-dark" aria-labelledby="con-t">
  <div class="wrap split">
    <div><p class="eyebrow" data-reveal>For landscape architects and consultants</p><h2 class="h2" id="con-t" data-reveal style="margin-top:16px">Specs you can put in a <em>drawing.</em></h2></div>
    <div class="tiles" data-reveal style="--rd:1">
      <div class="tile">{ic("doc")}<h3>A spec page per product</h3><p>Code, dimensions, platform height, age range and published safety zone for all {COUNT} outdoor products.</p><a class="link" href="/playgrounds/">Browse the range {ARROW}</a></div>
      <div class="tile">{ic("plan")}<h3>Send a DXF or PDF, get a layout</h3><p>Send your site plan as DXF, PDF or a photo with dimensions. We return a layout with every safety zone drawn.</p><a class="link" href="/contact/">Send your plan {ARROW}</a></div>
      <div class="tile">{ic("download")}<h3>The full catalogue</h3><p>All five collections in one PDF for your library.</p><a class="link" href="/downloads/dupedia-playground-catalogue.pdf">Download (7&nbsp;MB) {ARROW}</a></div>
    </div>
  </div>
</section>'''
    body = phero("Who we work with", "Built for the people|who <em>commission</em> play.",
                 "Developers, hotels, schools, malls, operators and public bodies each need something different from a play space. Here is where each one usually starts, and what we need to quote.",
                 crumbs=[("Home", "/"), ("Who we work with", "/who-we-work-with/")],
                 actions="".join(f'<a class="chip" style="text-decoration:none" href="#{s[0]}">{s[1]}</a>' for s in SECTORS)) + f'<div class="wrap">{secs}</div>{consult}{cta_band()}'
    page("/who-we-work-with/", "Playgrounds for developers, hotels, schools, malls and parks",
         "How Dupedia plans play spaces for real estate developers, hotels and resorts, schools, shopping malls, entertainment operators and municipalities in Egypt, and what we need to quote.",
         body, active="/who-we-work-with/", crumbs=[("Home", "/"), ("Who we work with", "/who-we-work-with/")])

def build_guide():
    z = zone_of(Y301); d = dims_of(Y301)
    rows = "".join(f'''<tr><td><a href="/playgrounds/?c={c["key"]}#range">{e(c["name"])}</a></td><td class="num">{n}</td><td class="num">{nr}</td>
<td><a href="{sm[0]["url"]}">{e(sm[0]["name"])}</a><br><span class="muted">{sm[1][1]:.2f} × {sm[1][2]:.2f} m</span></td>
<td><a href="{lg[0]["url"]}">{e(lg[0]["name"])}</a><br><span class="muted">{lg[1][1]:.2f} × {lg[1][2]:.2f} m</span></td><td class="num">{med:.1f}×</td></tr>''' for c, n, nr, sm, lg, med in coll_stats())
    faqs = [
        ("What is a safety zone?", "The free area a layout must keep around a piece of play equipment, as published by its manufacturer. Nothing else goes inside it: no other equipment, no benches, no trees, no paths crossing it."),
        ("Does the fit check certify my layout?", "No. It checks geometry against the published figures: whether equipment and zones fit your site and stay clear of each other. It is not a safety certification. We review every layout before quoting."),
        ("Can a product be turned to fit?", "Yes. The fit check on this site tries each product in both orientations, and we do the same when we draw your layout."),
        ("Some products say “zone set in your layout”. What does that mean?", f"The manufacturer publishes a fixed zone for {ZKIND['rect']} of the {COUNT} products. For the others, the zone is published as an area only ({ZKIND['area']}) or set per site plan ({ZKIND['plan']}), so we draw it when we lay out your site."),
        ("Which files can I send?", "A PDF or DXF site plan is ideal. A photo with rough dimensions is enough to start. If you work in CAD, a DXF export is easiest for us to measure from."),
        ("Do you give prices online?", "No. Prices depend on the products, the site and the surfacing, so we prepare a quotation for each project."),
    ]
    faq = "".join(f'<details><summary>{q}<span class="pm" aria-hidden="true"></span></summary><div class="ans"><p>{a}</p></div></details>' for q, a in faqs)
    body = phero("Planning guide", "How much space does a|playground <em>need?</em>",
                 "More than the equipment itself. Here is how safety zones work, what the figures in our range say, and what to prepare before you send us a plan.",
                 crumbs=[("Home", "/"), ("Planning guide", "/planning-guide/")]) + f'''
<section class="sec-tight" style="padding-top:0">
  <div class="wrap insight">
    <div class="prose" data-reveal>
      <h2 class="h3" style="color:var(--charcoal)">Plan the zone, not just the <em>equipment.</em></h2>
      <p style="margin-top:20px">Every structure in our outdoor range has a published safety zone: the free area the layout must keep around it. It is usually much larger than the structure.</p>
      <p>{e(Y301["name"])} ({Y301["code"]}) stands on {d[0]:.2f} × {d[1]:.2f}&nbsp;m, about {Y_FOOT:.1f}&nbsp;m². Its zone is {z[1]:.2f} × {z[2]:.2f}&nbsp;m, about {Y_ZONE:.0f}&nbsp;m², which is {Y_RATIO:.1f} times its footprint. If a yard is planned from the footprint, it will not fit.</p>
    </div>
    <figure class="insight-fig mask-tr" data-reveal="mask">{plan_svg(z[1], z[2], d[0], d[1], f"{Y301['name']}: footprint inside its safety zone, to scale")}</figure>
  </div>
</section>
<section class="sec-tight">
  <div class="wrap">
    <div class="sec-head"><h2 class="h3" data-reveal>Safety zones across the <em>range</em></h2><p data-reveal>Calculated from the manufacturer’s published figures for products with a rectangular zone. The ratio is zone area divided by footprint area.</p></div>
    <div class="tbl-wrap" data-reveal><table class="tbl"><caption class="sr">Safety zone figures by collection</caption>
      <thead><tr><th scope="col">Collection</th><th scope="col" class="num">Products</th><th scope="col" class="num">In this comparison</th><th scope="col">Smallest zone</th><th scope="col">Largest zone</th><th scope="col" class="num">Median zone ÷ footprint</th></tr></thead>
      <tbody>{rows}</tbody></table></div>
    {EXCL_NOTE}
  </div>
</section>
<section class="sec">
  <div class="wrap split">
    <div><p class="eyebrow" data-reveal>Before you send a plan</p><h2 class="h2" data-reveal style="margin-top:16px">Six things that make a <em>quote</em> faster.</h2><p class="lede" data-reveal style="margin-top:20px">You don’t need all of them to start. A rough sketch with measurements is enough for a first conversation.</p></div>
    <ol class="checklist" data-reveal style="--rd:1">
      <li><span><b>Location</b>City or area, and whether the site is indoors or outdoors.</span></li>
      <li><span><b>Usable area or a site plan</b>PDF, DXF, or a photo with rough dimensions. Note trees, drains, levels and access.</span></li>
      <li><span><b>Who will use it</b>Age groups, and roughly how many children at once.</span></li>
      <li><span><b>Type of space</b>Outdoor playground, indoor or soft play, water, or something else.</span></li>
      <li><span><b>Target opening date</b>Or the tender and planning stage you are at.</span></li>
      <li><span><b>Budget range</b>If you know it. It helps us suggest the right scale.</span></li>
    </ol>
  </div>
</section>
<section class="sec-tight sec-white">
  <div class="wrap split">
    <div><h2 class="h2" data-reveal>Questions we <em>hear</em> often</h2></div>
    <div class="faq" data-reveal style="--rd:1">{faq}</div>
  </div>
</section>
{cta_band(title="Check your plan with <em>us.</em>", text="Send your site plan and the products you are considering. We check each one against its published safety zone and tell you what fits.", secondary=("Check what fits", "/#fit"))}'''
    ld = [{"@type": "Article", "headline": "How much space does a playground need?", "about": "Playground safety zones and site planning",
           "author": {"@id": BASE + "/#org"}, "publisher": {"@id": BASE + "/#org"}, "dateModified": TODAY, "mainEntityOfPage": BASE + "/planning-guide/", "inLanguage": "en"}]
    page("/planning-guide/", "Playground safety zones: how much space a playground needs",
         f"Why a play unit needs more space than it takes up: how safety zones work, figures across {COUNT} playground products, and what to prepare before you ask for a quote.",
         body, active="/planning-guide/", ld=ld, crumbs=[("Home", "/"), ("Planning guide", "/planning-guide/")])

def build_about():
    body = phero("About Dupedia", "Serious about <em>play</em>|since 1989.",
                 "Dupedia designs, supplies and installs places to play: playgrounds, soft play, arcades, water parks and amusement attractions. We build them for the developers, hotels, schools, malls and operators who need them to be safe, look good and last.",
                 crumbs=[("Home", "/"), ("About", "/about/")]) + f'''
<section class="band-dark facts" aria-label="Dupedia in numbers">
  <div class="wrap facts-in">
    <div data-reveal><b class="lime">1989</b><span>Established</span></div>
    <div data-reveal style="--rd:1"><b>5</b><span>Divisions, one team</span></div>
    <div data-reveal style="--rd:2"><b>{COUNT}</b><span>Outdoor products, each fully specified</span></div>
    <div data-reveal style="--rd:3"><b>{tbc("Projects delivered")}</b><span>Projects delivered</span></div>
  </div>
</section>
{ceo_note()}
<section class="sec">
  <div class="wrap split">
    <div data-reveal><h2 class="h2">Our <em>story</em></h2></div>
    <div data-reveal style="--rd:1">
      <div class="tbc-block"><b>Company story · to be supplied</b>Founding, what Dupedia makes in-house and what it sources, the team, installation and after-sales service. 80–120 words, approved facts only.</div>
      <div class="tbc-block" style="margin-top:12px"><b>Certifications and standards · to be supplied</b>Name any standards the equipment and installation are certified to (for example EN 1176/1177), with the certificate holder and date. Nothing is claimed until it is confirmed in writing.</div>
    </div>
  </div>
</section>
{clients_band('cl-about')}
<section class="sec sec-white">
  <div class="wrap">
    <div class="sec-head"><div><p class="eyebrow" data-reveal>How we work</p><h2 class="h2" data-reveal>Four things you can <em>hold</em> us to.</h2></div></div>
    <div class="tiles">
      <div class="tile" data-reveal>{ic("chat")}<h3>One partner, first sketch to handover</h3><p>Design, supply and installation by one team, across all five kinds of play space.</p></div>
      <div class="tile" data-reveal style="--rd:1">{ic("ruler")}<h3>We measure first</h3><p>Layouts start from your site’s real numbers: usable area, levels, access, and the trees and drains already there.</p></div>
      <div class="tile" data-reveal style="--rd:2">{ic("dim")}<h3>Real sizes, real codes</h3><p>Every product carries a code and a full specification, so your team can plan before a site visit.</p></div>
      <div class="tile" data-reveal style="--rd:3">{ic("check")}<h3>No guessed figures</h3><p>Every spec comes from the approved product sheet. If a figure is missing, we confirm it in writing; we never estimate it.</p></div>
    </div>
  </div>
</section>
<section class="sec">
  <div class="wrap split">
    <figure class="split-media mask-bl" data-reveal="mask"><img src="{BY["SW-E104"]["img"]}" srcset="{BY["SW-E104"]["thumb"]} 560w, {BY["SW-E104"]["img"]} 1100w" sizes="(max-width:860px) 92vw, 46vw" alt="{e(BY["SW-E104"]["name"])}, product visual" width="1100" height="700" loading="lazy"></figure>
    <div data-reveal style="--rd:1"><p class="eyebrow">Our outdoor range</p><h2 class="h2" style="margin-top:16px">Made with a partner in <em>Cairo.</em></h2>
      <p class="lede" style="margin-top:20px">Our wooden outdoor playground range is made by our manufacturing partner Soliwood in Cairo, and supplied and installed by Dupedia: {COUNT} wooden products in five collections, from toddler playhouses to landmark play landscapes, in seven finishes.</p>
      <div class="phero-act"><a class="btn" href="/playgrounds/">See the range {ARROW}</a><a class="link" href="/downloads/dupedia-playground-catalogue.pdf">{ic("download","ic ic-s")} Catalogue (PDF)</a></div></div>
  </div>
</section>
{cta_band()}'''
    ld = [{"@type": "AboutPage", "name": "About Dupedia", "url": BASE + "/about/", "about": {"@id": BASE + "/#org"}}]
    page("/about/", "About Dupedia: serious about play since 1989",
         "Dupedia designs, supplies and installs playgrounds, soft play, arcades, water parks and amusement attractions in Egypt. How we work, and what you can hold us to.",
         body, active="/about/", ld=ld, crumbs=[("Home", "/"), ("About", "/about/")])

def build_contact():
    roles = ["", "Real estate developer", "Hotel or resort", "School or university", "Shopping mall", "Entertainment operator", "Municipality or government", "Landscape architect or consultant", "Other"]
    types = ["Outdoor playground", "Indoor & soft play", "Arcade / FEC", "Water park", "Amusement attraction", "Not sure yet"]
    timings = ["Not decided", "Within 3 months", "3–6 months", "6–12 months", "Tender / planning stage"]
    opt = lambda xs: "".join(f'<option value="{e(x)}">{e(x) or "Choose one"}</option>' for x in xs)
    c = CFG["contact"]
    body = phero("Contact", "Tell us about|your <em>space.</em>",
                 "Share the basics and your shortlist. A rough sketch with measurements is enough to start.",
                 crumbs=[("Home", "/"), ("Contact", "/contact/")]) + f'''
<section class="sec-tight" style="padding-top:0">
  <div class="wrap form-wrap">
    <div class="contact-support">
      <h2 class="h4">What happens next</h2>
      <ol class="next-steps">
        <li>{ic("doc","ic")}<span>The Dupedia team reads your request and replies using the details you give. {tbc("Reply time")}</span></li>
        <li>{ic("ruler","ic")}<span>We look at your site: a plan, photos with rough dimensions, or a visit.</span></li>
        <li>{ic("plan","ic")}<span>You get a layout with every safety zone drawn, and a quotation.</span></li>
      </ol>
      <dl class="contact-list">
        <div><dt>Sales</dt><dd>{contact_line("phone")}</dd></div>
        <div><dt>WhatsApp</dt><dd>{contact_line("whatsapp")}</dd></div>
        <div><dt>Email</dt><dd>{contact_line("email")}</dd></div>
        <div><dt>Head office</dt><dd>{contact_line("address")}</dd></div>
      </dl>
      <div class="sl-box" id="sl-box" aria-live="polite">
        <h2>Your shortlist</h2>
        <ul class="sl-list" id="sl-list"></ul>
        <p class="muted" id="sl-empty" style="font-size:15px">No products yet. Use <b>+ Shortlist</b> on any product to add it, or <a class="link-plain" href="/playgrounds/">browse the range</a>.</p>
      </div>
    </div>
    <div class="contact-enquiry">
      <form class="form" id="enq-form" novalidate aria-labelledby="form-t">
        <h2 class="h3" id="form-t">Request a quote</h2>
        <p class="muted" style="margin:8px 0 28px;font-size:15px">Fields marked required are the only ones we need.</p>
        <div class="form-grid">
          <label class="field" for="f-name"><span>Full name <i class="req">required</i></span><input id="f-name" name="name" type="text" autocomplete="name" required></label>
          <label class="field" for="f-company"><span>Company</span><input id="f-company" name="company" type="text" autocomplete="organization"></label>
          <label class="field" for="f-email"><span>Email <i class="req">required</i></span><input id="f-email" name="email" type="email" autocomplete="email" required></label>
          <label class="field" for="f-phone"><span>Phone / WhatsApp</span><input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"></label>
          <label class="field" for="f-role"><span>I am a</span><select id="f-role" name="role">{opt(roles)}</select></label>
          <label class="field" for="f-type"><span>Project type</span><select id="f-type" name="projectType">{opt(types)}</select></label>
          <label class="field" for="f-loc"><span>Project location <i class="req">required</i></span><input id="f-loc" name="location" type="text" autocomplete="address-level2" placeholder="City or area" required></label>
          <label class="field" for="f-site"><span>Available space</span><input id="f-site" name="site" type="text" placeholder="e.g. 15 × 10 m"></label>
          <label class="field span2" for="f-time"><span>Timing</span><select id="f-time" name="timing">{opt(timings)}</select></label>
          <label class="field span2" for="f-msg"><span>Tell us more</span><textarea id="f-msg" name="message" rows="5" placeholder="Who the space is for, how many at once, anything on site we should know"></textarea></label>
          <input type="hidden" id="f-shortlist" name="shortlist">
          <div class="hp" aria-hidden="true"><label for="f-website">Leave this empty</label><input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        </div>
        <p class="form-err" id="form-err" role="alert" hidden></p>
        <div class="form-foot">
          <button class="btn btn-lime" type="submit" id="f-submit">Send my request {ARROW}</button>
          <p class="form-note">We use these details only to reply to your enquiry. <a class="link-plain" href="/privacy/">Privacy</a></p>
        </div>
      </form>
      <div class="form state" id="form-done" hidden tabindex="-1">
        {block_band([("sq","c"),("qt","l"),("ci","c")], "snap-in")}
        <h2 class="h3">Request <em>received.</em></h2>
        <p>Reference <b id="done-ref"></b>. The Dupedia team will contact you using the details you gave.</p>
        <button type="button" class="link" id="done-new">Send another request</button>
      </div>
      <div class="form state" id="form-off" hidden tabindex="-1">
        <h2 class="h3">Online sending isn’t <em>connected</em> yet.</h2>
        <p>Your request has <b>not</b> been sent. Copy it below and send it to the Dupedia team{" by email or WhatsApp" if (c.get("email") or c.get("whatsapp")) else ""}.</p>
        <textarea id="off-text" rows="9" readonly aria-label="Your request as text"></textarea>
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
          <button type="button" class="btn" id="off-copy">Copy request</button>
          <a class="btn btn-ghost" id="off-mail" hidden>Open in email</a>
          <a class="btn btn-ghost" id="off-wa" hidden>Send on WhatsApp</a>
          <span id="off-status" aria-live="polite" class="muted"></span>
        </div>
        <button type="button" class="link" id="off-back">Back to the form</button>
      </div>
    </div>
  </div>
</section>'''
    ld = [{"@type": "ContactPage", "name": "Request a quote", "url": BASE + "/contact/", "about": {"@id": BASE + "/#org"}}]
    page("/contact/", "Request a playground quote",
         "Tell Dupedia about your space: location, size, who it is for and your timing. Add products from the range to your shortlist and they travel with your request.",
         body, active="/contact/", ld=ld, catalog=True, crumbs=[("Home", "/"), ("Contact", "/contact/")])

def build_privacy():
    body = phero("Privacy", "Your details, <em>briefly.</em>", "What the quote form collects, why, and what we do with it.",
                 crumbs=[("Home", "/"), ("Privacy", "/privacy/")]) + f'''
<section class="sec-tight" style="padding-top:0"><div class="wrap prose">
  <h2 class="h4" style="color:var(--charcoal)">What we collect</h2>
  <p>When you send a quote request we receive the details you type into the form: your name, company, email, phone, role, project type and location, available space, timing, your message and the products on your shortlist.</p>
  <h2 class="h4" style="color:var(--charcoal);margin-top:32px">Why</h2>
  <p>Only to reply to your enquiry and prepare a quotation. We do not sell your details or add you to a mailing list without asking.</p>
  <h2 class="h4" style="color:var(--charcoal);margin-top:32px">Stored on your device</h2>
  <p>Your shortlist is kept in your own browser so it is still there when you come back. It is not sent anywhere until you send a request.</p>
  <h2 class="h4" style="color:var(--charcoal);margin-top:32px">Cookies and analytics</h2>
  <p>{"This site uses Plausible, a cookie-free analytics service that does not collect personal data." if CFG["analytics"].get("plausibleDomain") else "This site sets no tracking cookies and runs no analytics."}</p>
  <h2 class="h4" style="color:var(--charcoal);margin-top:32px">Contact</h2>
  <p>To ask what we hold about you, or to have it deleted: {contact_line("email")}. Data controller: Dupedia, {contact_line("address")}.</p>
  <p class="muted" style="margin-top:24px">Last updated {TODAY}. {tbc("Legal review")}</p>
</div></section>'''
    page("/privacy/", "Privacy", "How Dupedia uses the details you send through the quote form.", body, crumbs=[("Home", "/"), ("Privacy", "/privacy/")])

def build_404():
    body = f'''<section class="sec nf"><div class="wrap">
  {block_band([("sq","c"),("qt","l"),("gap","c"),("ci","c")], "snap-in")}
  <p class="eyebrow">Page not found · 404</p>
  <h1 class="h1" style="margin-top:16px">This piece doesn’t <em>fit</em> here.</h1>
  <p class="lede" style="margin-top:20px">The page may have moved. These will get you back on track.</p>
  <div class="phero-act"><a class="btn" href="/">Home {ARROW}</a><a class="link" href="/playgrounds/">Playground range {ARROW}</a><a class="link" href="/contact/">Request a quote {ARROW}</a></div>
</div></section>'''
    page("/404.html", "Page not found", "This page could not be found. Find playground products, planning help or request a quote from Dupedia.", body, robots="noindex")


# ------------------------------------------------------------------ factory and manufacturing
ISO = CFG.get("iso9001") or {}
ISO_N = [0]  # unique ids for the ring path when a page shows the badge more than once
def iso_badge(size=168):
    """Dupedia-designed certification badge (not the ISO logo, which certified companies may not use)."""
    ISO_N[0] += 1; rid = f"isoring{ISO_N[0]}"
    ring = "QUALITY MANAGEMENT SYSTEM · CERTIFIED · "
    return f'''<span class="iso" style="--iso:{size}px" role="img" aria-label="ISO 9001 certified quality management system">
  <svg viewBox="0 0 200 200" aria-hidden="true"><defs><path id="{rid}" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
    <circle cx="100" cy="100" r="98" class="iso-bg"/><g class="iso-spin"><text class="iso-ring"><textPath href="#{rid}" textLength="482" lengthAdjust="spacing">{ring}</textPath></text></g>
    <circle cx="100" cy="100" r="58" class="iso-core"/>
    <text x="100" y="96" text-anchor="middle" class="iso-big">ISO</text><text x="100" y="128" text-anchor="middle" class="iso-num">9001</text></svg>
</span>'''

def iso_details():
    body = e(ISO["certificationBody"]) if ISO.get("certificationBody") else tbc("Certification body")
    num = e(ISO["certificateNumber"]) if ISO.get("certificateNumber") else tbc("Certificate number")
    return body, num

SAFETY = e(CFG["safetyStandard"]) if CFG.get("safetyStandard") else "international playground safety requirements"
PILLARS = [
    ("check", "Selected materials", "Timber, steel and fittings chosen for outdoor play and inspected before they enter production."),
    ("safety", "Quality control at every stage", "Each stage of manufacturing has its own check, from incoming material to the finished, packed product."),
    ("doc", "ISO 9001 certified", "Our quality management system is certified to ISO 9001, so every order follows the same documented process."),
    ("users", f"Made to {SAFETY}", "Designed and built around published safety zones and the safety requirements international buyers expect."),
    ("arrow", "Ready for global markets", "Full codes, dimensions and documentation for every product, so it can stand next to any imported brand in a tender."),
]
MFG_STEPS = [
    ("Materials in", "Timber, steel, fittings and finishes are selected for outdoor play and inspected on arrival. Nothing enters production without passing that check."),
    ("Cutting and machining", "Parts are cut and machined to the approved drawings for each product code, so every set is made to the same specification."),
    ("Sanding and finishing", "Edges and surfaces are smoothed for small hands, then finished for sun and weather."),
    ("Assembly and fit check", "Structures are assembled and checked for fit in the factory, before anything leaves for site."),
    ("Final inspection", "Each order is inspected against its product specification and signed off under our ISO 9001 procedures."),
    ("Pack, deliver, install", "Components are packed with their drawings, delivered and installed by our team, then handed over."),
]

def worker_figure(cls="", eager=False):
    return f'''<figure class="worker {cls}">
  <span class="worker-ball" aria-hidden="true"></span>
  <img src="/img/factory-worker-embroidered.webp" width="1186" height="1327" {"fetchpriority=" + chr(34) + "high" + chr(34) if eager else "loading=" + chr(34) + "lazy" + chr(34)} decoding="async" alt="A Dupedia factory worker in a hard hat and safety vest with the Dupedia logo embroidered directly on the vest, arms crossed, smiling.">
</figure>'''

def factory_teaser():
    pills = "".join(f'<li data-reveal style="--rd:{i}">{ic(icn, "ic ic-s")}<span>{t}</span></li>' for i, (icn, t, _) in enumerate(PILLARS))
    return f'''<section class="sec factory-teaser" aria-labelledby="ft-t">
  <div class="wrap factory-grid">
    {worker_figure()}
    <div class="factory-copy">
      <p class="eyebrow dot" data-reveal>Our factory</p>
      <h2 class="h1" id="ft-t" data-reveal style="margin-top:18px">Made by people who are serious about <em>play.</em></h2>
      <p class="lede" data-reveal style="margin-top:22px">We manufacture in our own factory, from selected materials, with quality control at every stage and an ISO 9001 certified quality system.</p>
      <ul class="pills">{pills}</ul>
      <div class="phero-act" data-reveal>{iso_badge(112)}<a class="btn" href="/our-factory/" data-magnetic>Inside our factory {ARROW}</a></div>
    </div>
  </div>
</section>'''

def build_factory():
    steps = "".join(f'<li data-reveal><span class="n"></span><h3 class="h3">{n}</h3><p>{t}</p></li>' for n, t in MFG_STEPS)
    tiles = "".join(f'<div class="tile" data-reveal style="--rd:{i}">{ic(icn)}<h3>{t}</h3><p>{d}</p></div>' for i, (icn, t, d) in enumerate(PILLARS))
    body_name, cert_no = iso_details()
    std = e(CFG["safetyStandard"]) if CFG.get("safetyStandard") else tbc("Standard, e.g. EN 1176 / EN 1177")
    hero = f'''<section class="phero factory-hero" aria-labelledby="fh-t">
  <div class="wrap factory-grid">
    <div class="factory-copy">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Our factory</li></ol></nav>
      <p class="eyebrow dot">Our factory · Manufacturing</p>
      {hline("Made by people|who are serious|about <em>play.</em>")}
      <p class="lede">What we make in our own factory is made one way: selected materials, a check at every stage of production, and an ISO 9001 certified quality management system behind every order.</p>
      <div class="phero-act">{iso_badge(124)}<a class="btn" href="/contact/" data-magnetic>Talk to our team {ARROW}</a></div>
    </div>
    {worker_figure("worker-hero", eager=True)}
  </div>
</section>'''
    body = hero + f'''
<div class="marquee" aria-hidden="true"><div class="marquee-track">{("<span>Selected materials<i class='mk'></i></span><span>Quality control at every stage<i class='mk' style='border-radius:50%'></i></span><span><em>ISO 9001 certified</em><i class='mk' style='border-radius:100% 0 0 0'></i></span><span>Ready for global markets<i class='mk' style='border-radius:999px 999px 0 0'></i></span>") * 4}</div></div>
<section class="sec" aria-labelledby="why-t">
  <div class="wrap">
    <div class="sec-head"><div><p class="eyebrow dot" data-reveal>What goes into every product</p><h2 class="h2" id="why-t" data-reveal>Five promises, made in the <em>factory.</em></h2></div><p data-reveal>Quality is not inspected in at the end. It is built in at each step, by the same team, to the same written process.</p></div>
    <div class="tiles tiles-5">{tiles}</div>
  </div>
</section>
<section class="sec band-dark" aria-labelledby="mp-t">
  <div class="wrap process">
    <div class="process-head"><p class="eyebrow dot" data-reveal>Manufacturing process</p><h2 class="h2" id="mp-t" data-reveal style="margin-top:16px">Six stages, six <em>checks.</em></h2><p class="lede" data-reveal style="margin-top:20px">Every stage ends with a quality check before the work moves on. Nothing skips a step.</p></div>
    <ol class="steps">{steps}</ol>
  </div>
</section>
<section class="sec band-lime" aria-labelledby="iso-t">
  <div class="wrap split" style="align-items:center">
    <div data-reveal>{iso_badge(260)}</div>
    <div>
      <p class="eyebrow dot" data-reveal>Certified quality</p>
      <h2 class="h2" id="iso-t" data-reveal style="margin-top:16px">ISO 9001: the same process, <em>every order.</em></h2>
      <p class="lede" data-reveal style="margin-top:20px">Our quality management system is certified to ISO 9001, the international standard for quality management. It means documented procedures, trained people, recorded inspections and continual improvement, from the first quote to handover.</p>
      <dl class="contact-list" data-reveal style="margin-top:28px"><div><dt>Certified by</dt><dd>{body_name}</dd></div><div><dt>Certificate</dt><dd>{cert_no}</dd></div></dl>
      <p class="source-note" data-reveal style="margin-top:18px">Certificate available on request.</p>
    </div>
  </div>
</section>
<section class="sec" aria-labelledby="gl-t">
  <div class="wrap split">
    <div><p class="eyebrow dot" data-reveal>Safety and global markets</p><h2 class="h2" id="gl-t" data-reveal style="margin-top:16px">Built to compete <em>anywhere.</em></h2></div>
    <div data-reveal style="--rd:1">
      <p class="lede">Every product is designed around its published safety zone and made to {SAFETY}. Each one carries a code, dimensions, platform height, age range and safety zone, the documentation international buyers and consultants expect.</p>
      <ul class="checklist" style="margin-top:24px">
        <li><span><b>Safety standard</b>{std}</span></li>
        <li><span><b>Published safety zones</b>For every product with a fixed zone, used in every layout we draw. <a class="link-plain" href="/planning-guide/">How safety zones work</a></span></li>
        <li><span><b>Full specification</b>Codes and dimensions for every product, ready for tender documents.</span></li>
        <li><span><b>Our wooden outdoor range</b>The {COUNT} products in our outdoor collections are made by our manufacturing partner Soliwood in Cairo, and supplied and installed by Dupedia. <a class="link-plain" href="/playgrounds/">See the range</a></span></li>
      </ul>
    </div>
  </div>
</section>
{cta_band(title="See it made, then see it <em>built.</em>", text="Tell us about your project. We can walk you through materials, finishes and the quality checks behind your order.")}'''
    ld = [{"@type": "AboutPage", "name": "Our factory and manufacturing process", "url": BASE + "/our-factory/", "about": {"@id": BASE + "/#org"}}]
    page("/our-factory/", "Our factory: ISO 9001 certified playground manufacturing",
         "How Dupedia manufactures playground equipment: selected materials, quality control at every stage, an ISO 9001 certified quality system, and products made for international safety requirements and global markets.",
         body, active="/our-factory/", ld=ld, crumbs=[("Home", "/"), ("Our factory", "/our-factory/")])


# ------------------------------------------------------------------ CEO note (text supplied by Adham El Kashef, 7 Nov 2026, unchanged)
CEO = {"name": "Adham El Kashef", "title": "Founder & CEO, Dupedia"}
CEO_PARAS = [
    "At Dupedia, we believe that a playground is much more than a place to play. It is where imagination takes shape, friendships begin, confidence grows, and unforgettable childhood memories are created.",
    "For us, creating a playground is an art. It starts with understanding the people who will use it, imagining the possibilities, and transforming ordinary spaces into extraordinary experiences.",
    "Every curve, every colour, every structure, and every detail has a purpose. We bring together creativity, thoughtful design, safety, and quality craftsmanship to create environments that inspire children to explore, discover, and dream without limits.",
    "Whether it is a school, a resort, a community, or a destination for family entertainment, our ambition remains the same: to create spaces that bring people together and make life a little more joyful.",
    "I am proud of what we create, but even prouder of the smiles, laughter, and memories that our work leaves behind.",
]
CEO_CLOSE = "Because at Dupedia, we are not just building playgrounds. We are creating the places where the best stories of childhood begin."
CEO_IMG = '<img src="/img/ceo-portrait.jpg" srcset="/img/ceo-portrait-760.jpg 760w, /img/ceo-portrait.jpg 1520w" sizes="(max-width: 900px) 92vw, 34vw" width="1520" height="2020" loading="lazy" decoding="async" alt="Adham El Kashef, Founder and CEO of Dupedia, in a black jacket in front of a framed photograph, black-and-white portrait.">'

SIG_N = [0]
def signature(cls="sig"):
    """Freehand signature (Herr Von Muellerhoff, SIL OFL): tilted, with an ink wobble and a pen flourish under the name.
    The cursive ink is revealed left to right by a scroll-controlled mask."""
    SIG_N[0] += 1; fid = f"ink{SIG_N[0]}"
    return (f'<svg class="{cls}" viewBox="0 0 640 260" role="img" aria-label="Signed, Adham El Kashef" data-sign>'
            f'<defs><filter id="{fid}" x="-5%" y="-20%" width="110%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/>'
            f'<feDisplacementMap in="SourceGraphic" scale="2.4"/></filter>'
            f'<mask id="{fid}-write" maskUnits="userSpaceOnUse" x="0" y="0" width="640" height="260"><path class="sig-pen" pathLength="1" d="M40 112 C140 98 210 112 290 106 S470 98 600 104" fill="none" stroke="white" stroke-width="210" stroke-linecap="butt"/></mask></defs>' 
            f'<g transform="rotate(-8 320 130)" filter="url(#{fid})">'
            f'<text x="320" y="150" text-anchor="middle" mask="url(#{fid}-write)">Adham El Kashef</text>'
            f'<path class="sig-flourish" d="M118 178 C 210 166, 330 162, 452 160 C 520 159, 560 150, 548 138 C 538 128, 506 146, 528 170 C 540 184, 578 182, 604 168"/>'
            f'</g></svg>')

def ceo_photo(extra=""):
    return f"""<figure class="ceo2-photo {extra}">
  <span class="ceo2-img">{CEO_IMG}</span>
  <span class="ceo2-shade" aria-hidden="true"></span>
  <figcaption>{signature()}<span class="ceo2-role">Founder &amp; CEO, Dupedia</span></figcaption>
</figure>"""

def ceo_note():
    lede, rest = CEO_PARAS[0], CEO_PARAS[1:]
    paras = "".join(f'<p data-reveal>{e(x)}</p>' for x in rest)
    close = words([("Because at Dupedia, we are not just building playgrounds. We are creating", False), ("the places where the best stories of childhood begin.", True)])
    return f"""<section class="ceo2" id="ceo-note" aria-labelledby="ceo-t">
  <div class="ceo2-grid">
    <div class="ceo2-media"><span class="ceo2-ball" aria-hidden="true"></span>{ceo_photo()}</div>
    <article class="ceo2-letter">
      <p class="eyebrow dot" data-reveal>A note from our CEO</p>
      <h2 class="display" id="ceo-t" data-reveal style="margin-top:22px">The art of creating <em>play.</em></h2>
      <p class="ceo2-lede" data-reveal>{e(lede)}</p>
      <div class="ceo2-body">{paras}</div>
      <p class="stmt ceo2-close">{close}</p>
      <div class="ceo2-sign" data-reveal>
        <span class="ceo2-warm">With warmth,</span>
        <span class="ceo2-name"><b>{e(CEO["name"])}</b>{e(CEO["title"])}</span>
      </div>
    </article>
  </div>
</section>"""

def ceo_teaser():
    close = words([("Because at Dupedia, we are not just building playgrounds. We are creating", False), ("the places where the best stories of childhood begin.", True)])
    return f"""<section class="ceo2 ceo2-teaser" aria-labelledby="ceot-t">
  <div class="ceo2-grid">
    <div class="ceo2-media"><span class="ceo2-ball" aria-hidden="true"></span>{ceo_photo("ceo2-short")}</div>
    <div class="ceo2-letter">
      <p class="eyebrow dot" data-reveal id="ceot-t">A note from our CEO</p>
      <p class="stmt ceo2-close" style="margin-top:28px">{close}</p>
      <p class="ceo2-name" data-reveal style="margin-top:28px"><b>{e(CEO["name"])}</b>{e(CEO["title"])}</p>
      <p data-reveal style="margin-top:28px"><a class="btn" href="/about/#ceo-note" data-magnetic>Read the full note {ARROW}</a></p>
    </div>
  </div>
</section>"""


# ------------------------------------------------------------------ planning and design (copy supplied by Dupedia, 7 Nov 2026)
PLAN_CONSIDER = ["Available area", "Dimensions", "Site conditions", "Age groups", "Functionality", "Safety requirements", "The right materials"]
PLAN_STEPS = [("Concept and space planning", "Your vision, the space and the people who will use it, turned into a first layout."),
              ("Product selection", "The right equipment for the space, the ages and the experience you want."),
              ("Material recommendations", "Materials chosen for the environment: sun, sand, heavy use or indoor."),
              ("Detailed design", "Every decision documented, with a clear purpose, ready to build.")]
PLAN_TABS = [("schools", "A school"), ("hotels", "A luxury resort"), ("developers", "A residential community"), ("operators", "A family entertainment destination")]

def planning_section():
    sect = {s[0]: s for s in SECTORS}
    chips = "".join(f'<li data-reveal style="--rd:{i}"><span class="tick" aria-hidden="true">{ic("check", "ic ic-s")}</span>{x}</li>' for i, x in enumerate(PLAN_CONSIDER))
    steps = "".join(f'<li data-reveal style="--rd:{i}"><span class="ps-n">0{i + 1}</span><h3>{n}</h3><p>{d}</p></li>' for i, (n, d) in enumerate(PLAN_STEPS))
    tabs = "".join(f'<button type="button" role="tab" id="pt-{k}" aria-controls="pp-{k}" aria-selected="{"true" if i == 0 else "false"}" tabindex="{0 if i == 0 else -1}">{lbl}</button>' for i, (k, lbl) in enumerate(PLAN_TABS))
    panels = "".join(f'<div role="tabpanel" id="pp-{k}" aria-labelledby="pt-{k}" class="pt-panel"{"" if i == 0 else " hidden"}><p>{sect[k][5]}</p><a class="link" href="/who-we-work-with/#{k}">How we approach {sect[k][1].lower()} {ARROW}</a></div>' for i, (k, _) in enumerate(PLAN_TABS))
    close = words([("We don't just fill spaces with equipment. We transform them into", False), ("experiences designed around the people who use them.", True)])
    return f"""<section class="sec plan" id="planning" aria-labelledby="plan-t">
  <div class="wrap">
    <div class="plan-grid">
      <figure class="plan-photo" data-reveal><span class="plan-stage"><span class="plan-quarter" aria-hidden="true"></span><img src="/img/planning-team-cutout.webp" width="923" height="1455" loading="lazy" decoding="async" alt="Two members of a planning team in business dress reviewing notes on a tablet and a notebook, black-and-white cut-out."></span></figure>
      <div class="plan-copy">
        <p class="eyebrow dot" data-reveal>Planning and design</p>
        <h2 class="h1" id="plan-t" data-reveal style="margin-top:18px">Beyond supplying. We create <em>experiences.</em></h2>
        <p class="plan-sub" data-reveal>Thoughtful planning · Purposeful design · The right solutions</p>
        <div class="plan-body">
          <p data-reveal>At Dupedia, we believe that every space has its own character, and every project deserves a solution designed around its unique needs.</p>
          <p data-reveal>Our work begins long before installation. Our planning and design team works closely with each client to understand their vision, the nature of the space, the target audience, and the experience they want to create.</p>
        </div>
        <h3 class="plan-h" data-reveal>What we consider, every time</h3>
        <ul class="consider">{chips}</ul>
      </div>
    </div>
    <div class="plan-steps-wrap">
      <p class="plan-lead" data-reveal>From the initial concept and space planning to product selection, material recommendations, and detailed design, every decision is made with a clear purpose.</p>
      <ol class="plan-steps">{steps}</ol>
    </div>
    <div class="plan-tabs-wrap">
      <div>
        <h3 class="h2" data-reveal>No one-size-fits-<em>all.</em></h3>
        <p class="lede" data-reveal style="margin-top:18px">A school, a luxury resort, a residential community, and a family entertainment destination each require a different approach.</p>
      </div>
      <div class="ptabs" data-tabs data-reveal>
        <div role="tablist" aria-label="Kinds of project">{tabs}</div>
        {panels}
      </div>
    </div>
    <p class="plan-goal" data-reveal>Our goal is to make the best use of every space, balance creativity with practicality, and deliver solutions that are beautiful, functional, durable, and built to last.</p>
    <p class="stmt plan-close">{close}</p>
  </div>
</section>"""


# ------------------------------------------------------------------ Dupedia X FORCE (owner's brief, 8 Nov 2026)
# Every "In X FORCE today" item below is a feature that exists in X FORCE (see X FORCE 1.1 docs: order stages, engineering
# queue and handover packs, production stages incl. quality inspection and rework, deadline status, teams, chat and
# notifications, payment verification, sales view of production progress, AI-assisted Market Intelligence).
# Nothing here describes a client portal, live client dashboard, logistics module or AI that X FORCE does not have.
XF_NODES = [
    ("eng", "Engineering &amp; design", "Planning, technical drawings, specifications and project development.",
     ["Engineering queue and assignment", "A handover pack for every order", "Technical files and plan exports", "Deadlines with full change history"], (17.1, 30)),
    ("mfg", "Manufacturing", "Production connected to each project's requirements and progress.",
     ["Production jobs tracked stage by stage", "In-house, outsourced or mixed production", "Ready-to-manufacture gates", "Workers and teams on every job"], (50, 10)),
    ("qc", "Quality control", "Every production stage monitored against our quality standards.",
     ["A dedicated quality inspection stage", "Rework flagged and tracked to completion", "Every stage change recorded", "Stage gates before a job is complete"], (82.9, 30)),
    ("pm", "Project management", "Timelines, teams and progress coordinated in one place.",
     ["One stage timeline for every order", "On track, at risk or delayed, at a glance", "Holds and delays must be explained", "A management control centre"], (82.9, 70)),
    ("ins", "Installation", "Installation and technical teams connected with management and the factory.",
     ["Installing and completed stages per project", "Teams assigned and visible", "Company-wide chat and notifications", "Site issues raised to the right people"], (50, 90)),
    ("cx", "Client experience", "Clearer communication, better coordination and real project visibility.",
     ["Your Dupedia contact sees production progress and deadlines", "Payments recorded and verified", "One project reference across every department", "Proposals with your site plan"], (17.1, 70)),
]
XF_STAGES = ["Quotation issued", "Client accepted", "Engineering", "Production", "Ready", "Installation", "Completed"]

def xf_icon(k):
    P = {
        "eng": '<path d="M4 20h16"/><path d="M6 20V9l6-5 6 5v11"/><path d="M10 20v-5h4v5"/>',
        "mfg": '<path d="M3 20V10l5 3V10l5 3V6l8 4v10z"/><path d="M7 17h2M12 17h2M17 17h1"/>',
        "qc": '<path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
        "pm": '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 13h3M8 16h6"/>',
        "ins": '<path d="M14 6a4 4 0 0 0-5.6 5.2L3 16.6 7.4 21l5.4-5.4A4 4 0 0 0 18 10l-2.6 2.6-3-3z"/>',
        "cx": '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>',
    }[k]
    return f'<svg class="ic" viewBox="0 0 24 24" aria-hidden="true">{P}</svg>'

def xforce_section():
    W, H, hx, hy = 1000, 640, 500, 320
    pts = [(x / 100 * W, y / 100 * H) for *_, (x, y) in XF_NODES]
    spokes = "".join(f'<path id="xfs{i}" class="xf-spoke" data-i="{i}" d="M{hx} {hy} L{px:.0f} {py:.0f}"/>' for i, (px, py) in enumerate(pts))
    ring = "M" + " L".join(f"{px:.0f} {py:.0f}" for px, py in pts) + " Z"
    packets = "".join(
        f'<circle class="xf-pkt" r="4"><animateMotion dur="{2.6 + i * .35:.2f}s" repeatCount="indefinite" begin="{i * .4:.1f}s" keyPoints="{"0;1" if i % 2 else "1;0"}" keyTimes="0;1" calcMode="linear"><mpath href="#xfs{i}"/></animateMotion></circle>'
        for i in range(len(pts)))
    ring_pkts = "".join(f'<circle class="xf-pkt xf-pkt-ring" r="3"><animateMotion dur="14s" repeatCount="indefinite" begin="{-i * 14 / 3:.2f}s"><mpath href="#xfring"/></animateMotion></circle>' for i in range(3))
    nodes = "".join(
        f'<button type="button" class="xf-node" data-i="{i}" style="left:{x}%;top:{y}%" aria-pressed="{"true" if i == 0 else "false"}" aria-controls="xf-detail">'
        f'<span class="xf-num">0{i + 1}</span>{xf_icon(k)}<span class="xf-name">{n}</span><span class="xf-bar" aria-hidden="true"><i></i></span></button>'
        for i, (k, n, d, f, (x, y)) in enumerate(XF_NODES))
    data = json.dumps([{"n": html.unescape(n), "d": d, "f": f} for k, n, d, f, _ in XF_NODES])
    first = XF_NODES[0]
    stages = "".join(f'<li style="--i:{i}"><span class="xf-dot" aria-hidden="true"></span>{s}</li>' for i, s in enumerate(XF_STAGES))
    return f"""<section class="sec xf" id="x-force" aria-labelledby="xf-t">
  <div class="xf-grid-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="xf-head">
      <p class="eyebrow dot" data-reveal>Dupedia X FORCE · our own operating system</p>
      <h2 class="h1" id="xf-t" data-reveal style="margin-top:18px">Beyond manufacturing. Powered by <em>intelligence.</em></h2>
      <p class="xf-sub" data-reveal>Meet the new era of playground solutions.</p>
    </div>
    <div class="xf-intro">
      <p class="lede" data-reveal>At Dupedia, innovation goes beyond the products we create. We are pioneering a technology-led, AI-assisted approach to the playground and leisure industry, where every stage of our operation is connected through our own operating system, Dupedia X FORCE.</p>
      <div class="xf-intro-2" data-reveal style="--rd:1">
        <p>From the first engineering drawings to manufacturing, quality control and final installation, X FORCE keeps our teams connected, our operations coordinated and every project moving forward.</p>
        <p>By connecting our factory, engineers, management and technical teams through one system, we keep greater visibility, stronger coordination and control throughout the whole project journey. Because an exceptional playground starts long before installation.</p>
      </div>
    </div>

    <div class="xf-console" data-xf data-reveal>
      <div class="xf-bar-top" aria-hidden="true"><span class="xf-lights"><i></i><i></i><i></i></span><span class="xf-title">X FORCE · operations network</span><span class="xf-live"><i></i>Connected</span></div>
      <div class="xf-eco">
        <svg class="xf-links" viewBox="0 0 {W} {H}" aria-hidden="true">
          <path id="xfring" class="xf-ring" d="{ring}"/>
          {spokes}{packets}{ring_pkts}
        </svg>
        <div class="xf-hub" aria-hidden="true">
          <span class="xf-orbit o1"></span><span class="xf-orbit o2"></span><span class="xf-orbit o3"></span>
          <span class="xf-core"><b>X FORCE</b><small>by Dupedia</small></span>
        </div>
        <div class="xf-nodes" role="group" aria-label="Departments connected by X FORCE">{nodes}</div>
      </div>
      <div class="xf-detail" id="xf-detail" aria-live="polite">
        <div><p class="xf-step">Stage <b id="xf-d-num">01</b> of 0{len(XF_NODES)}</p><h3 id="xf-d-name">{first[1]}</h3><p id="xf-d-desc">{first[2]}</p></div>
        <div><p class="xf-step">In X FORCE today</p><ul id="xf-d-list">{"".join(f"<li>{x}</li>" for x in first[3])}</ul></div>
      </div>
      <script type="application/json" id="xf-data">{data}</script>
    </div>

    <div class="xf-journey" data-reveal>
      <div class="xf-j-head"><h3 class="h3">Every project, one <em>timeline.</em></h3>
        <p class="xf-legend"><span><i style="--c:var(--lime)"></i>On track</span><span><i style="--c:var(--sun)"></i>At risk</span><span><i style="--c:var(--coral)"></i>Delayed</span></p></div>
      <ol class="xf-track">{stages}</ol>
      <p class="source-note">The order stages and deadline statuses X FORCE tracks for every project, shared by sales, engineering, the factory and installation.</p>
    </div>

    <div class="xf-close">
      <figure class="xf-field" data-reveal><span class="xf-field-ball" aria-hidden="true"></span><img src="/img/xforce-field.webp" width="721" height="649" loading="lazy" decoding="async" alt="A site engineer in a hard hat and safety vest checking a tablet, black-and-white cut-out."></figure>
      <div>
        <div class="xf-ai" data-reveal><p class="xf-step">Where AI works today</p><p>X FORCE uses AI to research markets and prospective projects, and labels every finding as source-backed or AI interpretation, so our people make the decisions with the facts in front of them.</p></div>
        <p class="xf-statement" data-reveal>One vision. One connected system. <em>Every detail under control.</em></p>
        <p data-reveal style="margin-top:28px"><a class="btn" href="/contact/" data-magnetic>Start a project with us {ARROW}</a></p>
      </div>
    </div>
  </div>
</section>"""


# ------------------------------------------------------------------ X FORCE intro (replaces "Featured products", owner brief 8 Nov 2026)
# Headline: the owner's preferred "Egypt's first..." claim is not verifiable, so the brief's fallback is used.
# Stage copy only describes what X FORCE does today (production stages, quality inspection and rework, safety-zone
# checks on layouts, installation on the shared timeline). AI in X FORCE is research, so it is called "AI-assisted".
XFI_STAGES = [
    ("mfg", "Planning &amp; engineering", "PLAN", "Sales, design and engineering work from one project record, so drawings, quantities and timelines stay connected from the first brief."),
    ("qc", "Manufacturing &amp; quality", "MAKE", "Production is tracked stage by stage against each project. A dedicated inspection step sends anything that fails to rework, and it stays visible until it passes."),
    ("safe", "Safety &amp; coordination", "SAFE", "Layouts are checked against each product's published safety zone, and every team sees holds, delays and decisions as they happen."),
    ("ins", "Installation &amp; handover", "BUILD", "Site teams, the factory and project management share one timeline through to handover, so the client deals with one connected team."),
]

def xforce_intro():
    def words(text, start=0):
        out = []
        for k, w in enumerate(text.split(" ")):
            out.append(f'<span class="xw"><span style="--i:{start + k}">{w}</span></span>')
        return " ".join(out)
    h = (f'<span class="xl">{words("An", 0)} <span class="xw xw-ai"><span style="--i:1"><em>AI-powered</em></span></span></span> '
         f'<span class="xl">{words("company. Built around", 2)}</span> '
         f'<span class="xl">{words("intelligent operations.", 5)}</span>')
    links = ["AI-powered business operations", "Intelligent internal systems", "Connected manufacturing &amp; engineering",
             "Smarter planning &amp; execution", "Live coordination between teams", "A connected client experience"]
    chips = "".join(f'<li data-reveal style="--rd:{k}">{c}</li>' for k, c in enumerate(links))
    stages = "".join(
        f'<li class="xfi-st" data-i="{i}"><span class="xfi-node shp-{k}" aria-hidden="true"><i></i></span>'
        f'<span class="xfi-n">0{i + 1}</span><h3>{n}</h3><p>{d}</p><span class="xfi-tag">Connected in X FORCE</span></li>'
        for i, (k, n, w, d) in enumerate(XFI_STAGES))
    big = "".join(f'<span data-i="{i}">' + "".join(f'<b style="--l:{j}">{ch}</b>' for j, ch in enumerate(w)) + '</span>' for i, (k, n, w, d) in enumerate(XFI_STAGES))
    leds = "".join(f'<span data-i="{i}"><i></i>{n}</span>' for i, (k, n, w, d) in enumerate(XFI_STAGES))
    return f"""<section class="xfi" id="powered-by-ai" aria-labelledby="xfi-t">
  <div class="xfi-texture" aria-hidden="true"></div>
  <div class="wrap xfi-intro">
    <p class="eyebrow dot" data-reveal>Dupedia X FORCE · AI-powered operations</p>
    <h2 class="xfi-h" id="xfi-t" data-reveal>{h}</h2>
    <div class="xfi-lead">
      <p class="lede" data-reveal>Dupedia runs on X FORCE, our own AI-powered operational ecosystem. It connects sales, planning, engineering, manufacturing, project management and installation, so our people, processes, data and projects work from one live, shared picture. X FORCE doesn’t build playgrounds. Our teams do. It keeps them connected, informed and a step ahead.</p>
      <p class="xfi-motto" data-reveal><span>Built smarter.</span> <span>Checked harder.</span> <span>Delivered <em>safer.</em></span></p>
    </div>
    <ul class="xfi-chips" aria-label="What X FORCE connects">{chips}</ul>
  </div>
  <div class="xfi-scroll" data-xfi>
    <div class="xfi-pin">
      <div class="xfi-big" aria-hidden="true">{big}</div>
      <div class="wrap xfi-grid">
        <figure class="xfi-photo xfi-cut">
          <span class="xfi-cutin"><span class="xfi-disc" aria-hidden="true"></span><img src="/img/xforce-engineer.webp" width="640" height="984" loading="lazy" decoding="async" alt="A Dupedia engineer in a hard hat and safety glasses checking project details on a tablet, black and white."></span>
          <figcaption class="xfi-sign"><span class="rope l" aria-hidden="true"></span><span class="rope r" aria-hidden="true"></span><span class="board"><i aria-hidden="true"></i>X FORCE <span class="sep" aria-hidden="true">·</span> <span id="xfi-now">{XFI_STAGES[0][1]}</span></span></figcaption>
          <span class="xfi-pile" aria-hidden="true"><b class="p0"></b><b class="p1"></b><b class="p2"></b><b class="p3"></b></span>
          <span class="xfi-leds" aria-hidden="true">{leds}</span>
        </figure>
        <div class="xfi-flow">
          <p class="xfi-flow-h">One connected system, every stage</p>
          <ol class="xfi-stages"><span class="xfi-line" aria-hidden="true"><i class="xfi-ball"><b></b></i></span>{stages}</ol>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap xfi-out"></div>
</section>"""

# ------------------------------------------------------------------ static files, sitemap, robots
def write_static():
    if OUT.exists(): shutil.rmtree(OUT)
    OUT.mkdir(parents=True)
    shutil.copytree(STATIC, OUT, dirs_exist_ok=True)
    (OUT / "assets").mkdir(exist_ok=True)
    shutil.copy(SRC / "assets" / "site.css", OUT / "assets" / "site.css")
    shutil.copy(SRC / "assets" / "site.js", OUT / "assets" / "site.js")
    shutil.copy(SRC / "assets" / "motion.js", OUT / "assets" / "motion.js")
    (OUT / "assets" / "catalog.js").write_text(CATALOG)

def write_meta():
    urls = "".join(f"<url><loc>{BASE}{u}</loc><lastmod>{TODAY}</lastmod></url>" for u in PAGES)
    (OUT / "sitemap.xml").write_text(f'<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>\n')
    robots = "User-agent: *\nDisallow: /\n# Review build: set siteUrl in src/config.json to publish.\n" if REVIEW else f"User-agent: *\nAllow: /\n\nSitemap: {BASE}/sitemap.xml\n"
    (OUT / "robots.txt").write_text(robots)
    (OUT / "site.webmanifest").write_text(json.dumps({"name": "Dupedia", "short_name": "Dupedia", "start_url": "/", "display": "browser",
        "background_color": "#FBFAF6", "theme_color": "#FBFAF6", "icons": [{"src": "/icon-512.png", "sizes": "512x512", "type": "image/png"}]}, indent=1))
    (OUT / "_headers").write_text("""/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
""")

if __name__ == "__main__":
    CATALOG = catalog_js(); CAT_V = hashlib.sha1(CATALOG.encode()).hexdigest()[:10]
    write_static()
    build_home(); build_playgrounds(); build_products(); build_divisions(); build_sectors()
    build_guide(); build_about(); build_factory(); build_contact(); build_privacy(); build_404()
    from i18n.build_ar import build as build_ar
    build_ar(OUT, PAGES, BASE)
    write_meta()
    for k, v in CFG["contact"].items():
        if not v: WARN.append(f"contact.{k} not supplied: [TBC] shown on the page")
    if REVIEW: WARN.insert(0, "siteUrl not set: REVIEW build (noindex, robots Disallow, canonical uses siteUrlPreview)")
    if not CFG.get("formEndpoint"): WARN.append("formEndpoint not set: the form shows the request as text to copy and says it was not sent")
    print(f"Built {len(PAGES)} pages into {OUT.relative_to(ROOT)}/")
    for w in WARN: print("  ! " + w)
