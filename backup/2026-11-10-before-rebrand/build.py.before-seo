"""Build the Dupedia website.

    python3 src/build.py            -> writes public/ (deployable static site)

No dependencies beyond the Python standard library. Content facts come from:
  src/data/products.json   verified manufacturer data (codes, sizes, zones, ages), unchanged
  src/config.json          business facts and integrations; null = not supplied yet ([TBC] on the page)
Nothing is invented: missing facts are rendered as visible [TBC] placeholders and listed by the build.
"""
import hashlib, html, json, re, shutil, statistics, datetime, pathlib, sys
from urllib.parse import quote

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC, OUT, STATIC = ROOT / "src", ROOT / "public", ROOT / "static"
D = json.loads((SRC / "data" / "products.json").read_text())
CFG = json.loads((SRC / "config.json").read_text())
COLL, P, FIN = D["collections"], D["products"], D["finishes"]
NO_IMAGE = {"SW-A411"}   # the source serves another product's photograph for this one (see product_flags.json)
REVIEW = not CFG.get("siteUrl")
BASE = (CFG.get("siteUrl") or CFG["siteUrlPreview"]).rstrip("/")
TODAY = datetime.date.today().isoformat()
YEAR = datetime.date.today().year
e = html.escape
WARN = []

# ------------------------------------------------------------------ helpers
def slugify(s): return re.sub(r"[^a-z0-9]+", "-", s.lower().replace("&", "and").replace("'", "")).strip("-")
for p in P:
    p["slug"] = f'{p["code"].lower()}-{slugify(p["name"])}'
    p["url"] = f'/playgrounds/{p["slug"]}/'
    p["img"] = None if p["code"] in NO_IMAGE else f'/img/{p["code"].lower()}.webp'
    p["thumb"] = None if p["code"] in NO_IMAGE else f'/img/{p["code"].lower()}-560.webp'
BY = {p["code"]: p for p in P}
CBY = {c["key"]: c for c in COLL}
COUNT = len(P)
CCOUNT = {c["key"]: sum(1 for p in P if p["collection"] == c["key"]) for c in COLL}

def nb(t):
    """Keep numbers with their units and L/W/H labels on one line."""
    t = e(t)
    t = re.sub(r"(^|\s)([LWH]) (?=\d)", lambda m: m.group(1) + m.group(2) + "&nbsp;", t)
    return re.sub(r"(\d) (m²|m|cm)(?![\w])", lambda m: m.group(1) + "&nbsp;" + m.group(2), t)

def tbc(label): return f'<span class="tbc" title="To be confirmed by Dupedia">[{e(label)} · TBC]</span>'

ICON = {
 "arrow": '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
 "download": '<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M4 20h16"/>',
 "dim": '<rect x="2" y="8" width="20" height="8" rx="1"/><path d="M6 8v3M10 8v4M14 8v3M18 8v4"/>',
 "users": '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14a5 5 0 0 1 5 5"/>',
 "safety": '<path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
 "zone": '<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 12h16M12 4v16"/>',
 "plat": '<path d="M4 20h16"/><path d="M8 14h8v6"/><path d="M12 3v8"/><path d="m9 6 3-3 3 3"/>',
 "plus": '<path d="M12 5v14M5 12h14"/>',
 "phone": '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
 "mail": '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
 "pin": '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
 "plan": '<path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15M15 6v15"/>',
 "ruler": '<path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>',
 "check": '<path d="m5 12 4.5 4.5L19 7"/>',
 "chat": '<path d="M4 5h16v11H9l-5 4z"/>',
 "doc": '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
}
def ic(name, cls="ic"): return f'<svg class="{cls}" viewBox="0 0 24 24" aria-hidden="true">{ICON[name]}</svg>'
ARROW = ic("arrow", "ic ic-s")
CUR, LAZY, FETCHHI = ' aria-current="page"', 'loading="lazy" ', 'fetchpriority="high"'

# Division marks, built from the four blocks exactly as on brand board G4 (p.5).
DIVISIONS = [
 # key, anchor, name, short text (approved copy), colour, fg, cells, project type for the form
 ("play", "playgrounds", "Outdoor playgrounds", "Play structures, swings and slides for parks, schools and compounds.", "#B8D241", "#262626", ['br100-tl', '', 'sq', 'br100-br'], "Outdoor playground"),
 ("soft", "soft-play", "Indoor &amp; soft play", "Soft play frames and indoor play centres, designed to fit your space.", "#F2643D", "#262626", ['circle', 'circle', 'circle', ''], "Indoor & soft play"),
 ("arcade", "arcades", "Arcades &amp; games", "Arcade machines and family entertainment centre fit-outs.", "#F7B32B", "#262626", ['sq', 'circle', 'sq', 'sq'], "Arcade / FEC"),
 ("water", "water-parks", "Water parks", "Slides, splash pads and aquatic play for resorts and parks.", "#1E9FB0", "#262626", ['half-b', 'half-b', 'half-t', 'half-t'], "Water park"),
 ("amuse", "amusement", "Amusement", "Rides and attractions for amusement parks and destinations.", "#6C5CE7", "#FFFFFF", ['br100-tl', 'br100-tr', 'sq', 'sq'], "Amusement attraction"),
]
RAD = {"": None, "sq": "0", "circle": "50%", "br100-tl": "100% 0 0 0", "br100-tr": "0 100% 0 0",
       "br100-br": "0 0 100% 0", "half-b": "0 0 999px 999px", "half-t": "999px 999px 0 0"}
def mark(key, size=None):
    d = next(x for x in DIVISIONS if x[0] == key)
    inner = "".join(f'<i style="background:{d[5]};border-radius:{RAD[c]}"></i>' if c else "<i></i>" for c in d[6])
    st = f"background:{d[4]}" + (f";--dm:{size}px" if size else "")
    return f'<span class="dmark" style="{st}" aria-hidden="true">{inner}</span>'

def block_band(spec, cls="", size=None):
    """spec: list of (shape, colour) where shape in sq, qt, qt-r, hf, ht, ci, gap."""
    col = {"c": "var(--text)", "l": "var(--lime)", "w": "var(--white)", "s": "var(--stone)", "cr": "var(--cream)"}
    blocks = "".join(f'<span class="blk {s}" style="--c:{col.get(c, c)};--i:{i}"></span>' for i, (s, c) in enumerate(spec))
    st = f' style="--b:{size}"' if size else ""
    return f'<div class="block-band {cls}" aria-hidden="true"{st}>{blocks}</div>'
BAND_MAIN = [("sq", "c"), ("qt", "l"), ("ht", "c"), ("ci", "l"), ("sq", "c"), ("hf", "l")]

def hline(text, tag="h1", cls="h1", id_=None, start=0):
    """Headline split into lines for the masked line-up animation. Lines separated by |."""
    lines = text.split("|")
    inner = " ".join(f'<span class="ln"><span style="--i:{start + i}">{ln.strip()}</span></span>' for i, ln in enumerate(lines))
    idattr = f' id="{id_}"' if id_ else ""
    return f'<{tag} class="{cls}"{idattr}>{inner}</{tag}>'

# ------------------------------------------------------------------ geometry (for server-rendered figures)
def nums(s): return [float(x) for x in re.findall(r"\d+(?:\.\d+)?", s or "")]
def zone_of(p):
    s = p["safetyZone"] or ""
    if re.search(r"plan|config|segment", s, re.I) or not s: return ("plan",)
    n = nums(s)
    if "m²" in s: return ("area", n[0])
    return ("rect", n[0], n[1]) if len(n) >= 2 else ("plan",)
def dims_of(p):
    n = nums(p["dimensions"])
    if len(n) < 2: return None
    k = 0.01 if re.search(r"\bcm\b", p["dimensions"]) else 1
    return (n[0] * k, n[1] * k)

def plan_svg(zl, zw, dl, dw, title, label_zone=True):
    VW, VH, pad = 400, 300, 40
    s = min((VW - 2 * pad) / max(zl, dl), (VH - 2 * pad) / max(zw, dw))
    cx, cy = VW / 2, VH / 2
    def r(l, w, extra): return f'<rect x="{cx - l*s/2:.1f}" y="{cy - w*s/2:.1f}" width="{l*s:.1f}" height="{w*s:.1f}" {extra}/>'
    lab = lambda x, y, t, a="middle": f'<text class="p-lab" x="{x:.1f}" y="{y:.1f}" text-anchor="{a}">{e(t)}</text>'
    g = r(zl, zw, 'class="p-zone"')
    g += r(dl, dw, 'class="p-prod"')
    if label_zone:
        g += lab(cx, cy - zw * s / 2 - 10, f"Safety zone {zl:.2f} × {zw:.2f} m")
        g += lab(cx, cy + zw * s / 2 + 20, f"Footprint {dl:.2f} × {dw:.2f} m")
    return f'<svg viewBox="0 0 {VW} {VH}" role="img" aria-label="{e(title)}">{g}</svg>'

# ------------------------------------------------------------------ assets
def ver(path): return hashlib.sha1(path.read_bytes()).hexdigest()[:10]
CSS_V = ver(SRC / "assets" / "site.css"); JS_V = ver(SRC / "assets" / "site.js"); MO_V = ver(SRC / "assets" / "motion.js")

# Intro loader: first visit per browser session, skipped with reduced motion. The inline script decides before
# first paint; a timer clears it even if the main scripts fail to load.
INTRO_JS = ("try{if(!sessionStorage.getItem('dp-intro')&&!matchMedia('(prefers-reduced-motion: reduce)').matches){"
            "document.documentElement.classList.add('intro');setTimeout(function(){document.documentElement.classList.remove('intro')},9000)}}catch(e){}")
LOADER_HTML = '''<div class="loader" role="dialog" aria-label="Loading Dupedia" aria-live="polite">
  <div class="loader-top"><img src="/brand/dupedia-logo-white.png" width="1570" height="346" alt="Dupedia"><button type="button" class="loader-skip">Skip intro</button></div>
  <div class="loader-stage"><div class="loader-cluster" aria-hidden="true">
    <i style="--c:var(--cream)"></i><i style="--c:var(--lime);--r:100% 0 0 0"></i><i style="--c:var(--lime);--r:50%"></i><i style="--c:var(--cream);--r:999px 999px 0 0"></i>
  </div></div>
  <div class="loader-bottom">
    <p class="loader-count" aria-hidden="true"><b>000</b><small>%</small></p>
    <div class="loader-line"><span>Serious about <em>play.</em></span><span class="hint">Move, or click to play with the blocks</span></div>
  </div>
  <span class="loader-bar" aria-hidden="true"></span>
</div>
<div class="loader-curtain" aria-hidden="true"></div>
'''

def catalog_js():
    data = {
        "collections": [{k: c[k] for k in ("key", "numeral", "name", "short", "description")} for c in COLL],
        "products": [{"code": p["code"], "name": p["name"], "coll": p["collection"], "dims": p["dimensions"], "zone": p["safetyZone"],
                      "age": p["age"], "amin": p.get("ageMin") or 0, "amax": p.get("ageMax") or 99, "thumb": p["thumb"], "url": p["url"]} for p in P],
    }
    return "window.DP_CATALOG=" + json.dumps(data, ensure_ascii=False, separators=(",", ":")) + ";\n"

FONTS = ("https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,500..600,100;1,9..144,500,100"
         "&family=Instrument+Sans:wght@400;500;600&display=swap")
FONT_AR = "https://fonts.googleapis.com/css2?family=Readex+Pro:wght@400;500;600&display=swap"  # loaded on /ar/ pages only (build_ar.py)
FONT_SIG = "https://fonts.googleapis.com/css2?family=Herr+Von+Muellerhoff&display=swap&text=" + quote("Adham El Kashef")

ORG = {
    "@type": "Organization", "@id": BASE + "/#org", "name": "Dupedia", "url": BASE + "/",
    "logo": BASE + "/brand/dupedia-logo-black.png", "foundingDate": "1989", "slogan": "Serious about play.",
    "founder": {"@type": "Person", "name": "Adham El Kashef", "jobTitle": "Founder & CEO"},
    "description": "Dupedia designs, supplies and installs places to play: playgrounds, soft play, arcades, water parks and amusement attractions, for developers, hotels, schools, malls and operators.",
    "areaServed": [{"@type": "Country", "name": c} for c in CFG.get("serviceArea", [])],
    "knowsAbout": ["Playground design", "Playground equipment supply and installation", "Soft play", "Water parks", "Family entertainment centres", "Amusement attractions"],
}
if CFG["contact"].get("email"): ORG["email"] = CFG["contact"]["email"]
if CFG["contact"].get("phone"): ORG["telephone"] = CFG["contact"]["phone"]
same = [v for v in CFG["social"].values() if v]
if same: ORG["sameAs"] = same

def crumbs_ld(items):
    return {"@type": "BreadcrumbList", "itemListElement": [
        {"@type": "ListItem", "position": i + 1, "name": n, "item": BASE + u} for i, (n, u) in enumerate(items)]}

# ------------------------------------------------------------------ layout
NAV = [("Playgrounds", "/playgrounds/"), ("What we build", "/what-we-build/"), ("Our factory", "/our-factory/"), ("Who we work with", "/who-we-work-with/"),
       ("Planning guide", "/planning-guide/"), ("About", "/about/")]

def header(active):
    links = "".join(f'<a href="{u}"{CUR if active == u else ""}>{n}</a>' for n, u in NAV)
    sheet_links = "".join(f'<a href="{u}"{CUR if active == u else ""}>{n}{ARROW}</a>' for n, u in NAV + [("Contact", "/contact/")])
    return f'''<a class="skip" href="#main">Skip to content</a>
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="hdr-logo" href="/" aria-label="Dupedia home"><img src="/brand/dupedia-logo-white.png" width="1570" height="346" alt="Dupedia"></a>
    <nav class="nav" aria-label="Main">{links}</nav>
    <div class="hdr-act">
      <a class="sl-pill" href="/contact/" data-sl-count hidden><span class="ball" aria-hidden="true"></span>Shortlist <span class="n">0</span></a>
      <a class="btn btn-s" href="/contact/">Request a quote</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="sheet" aria-label="Open menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<div class="sheet" id="sheet" hidden>
  <nav aria-label="Menu">{sheet_links}</nav>
  <div class="sheet-cta"><a class="btn" href="/contact/">Request a quote</a></div>
  {block_band(BAND_MAIN, size="34px")}
</div>'''

def contact_line(kind):
    c = CFG["contact"]
    if kind == "phone": return f'<a href="tel:{e(c["phone"])}">{e(c["phone"])}</a>' if c.get("phone") else tbc("Phone")
    if kind == "whatsapp": return f'<a href="https://wa.me/{re.sub(r"[^0-9]", "", c["whatsapp"])}">{e(c["whatsapp"])}</a>' if c.get("whatsapp") else tbc("WhatsApp")
    if kind == "email": return f'<a href="mailto:{e(c["email"])}">{e(c["email"])}</a>' if c.get("email") else tbc("Email")
    if kind == "address": return e(c["address"]) if c.get("address") else tbc("Office address")
    return ""

def footer():
    colls = "".join(f'<li><a href="/playgrounds/?c={c["key"]}">{e(c["short"])}</a></li>' for c in COLL)
    social = "".join(f'<li><a href="{e(u)}" rel="me noopener">{k.title()}</a></li>' for k, u in CFG["social"].items() if u) or f"<li>{tbc('Social links')}</li>"
    return f'''<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div class="ftr-brand">
        <img src="/brand/dupedia-logo-white.png" width="1570" height="346" alt="Dupedia" loading="lazy">
        <p class="brandline"><span>Serious about <em>play.</em></span></p>
      </div>
      <div><h2>Explore</h2><ul>{"".join(f'<li><a href="{u}">{n}</a></li>' for n, u in NAV)}<li><a href="/contact/">Contact</a></li></ul></div>
      <div><h2>Playground collections</h2><ul>{colls}<li><a href="/downloads/dupedia-playground-catalogue.pdf">Catalogue (PDF, 7&nbsp;MB)</a></li></ul></div>
      <div><h2>Contact</h2><ul><li><a href="/contact/">Request a quote</a></li><li>{contact_line("email")}</li><li>{contact_line("phone")}</li><li>{contact_line("address")}</li>{social}</ul></div>
    </div>
    {block_band(BAND_MAIN)}
    <div class="ftr-base"><span>© {YEAR} Dupedia. All rights reserved.</span><span>Product data as published by the manufacturer, October 2026 · <a href="/privacy/">Privacy</a></span></div>
  </div>
</footer>'''

def cta_band(title="Tell us about your <em>space.</em>", text="Share the basics and your shortlist. The Dupedia team replies using the details you give.", primary=("Request a quote", "/contact/"), secondary=("Download the catalogue", "/downloads/dupedia-playground-catalogue.pdf")):
    return f'''<section class="sec band-dark cta-band" aria-labelledby="cta-t">
  <span class="corner-mark" aria-hidden="true"></span>
  <div class="wrap">
    <p class="eyebrow dot" data-reveal>Let’s build something</p>
    <h2 class="cta-big" id="cta-t" data-reveal style="margin-top:24px">{title}</h2>
    <div class="cta-grid">
      <p class="lede" data-reveal>{text}</p>
      <div class="actions" data-reveal style="--rd:1"><a class="btn btn-lime btn-xl" href="{primary[1]}" data-magnetic>{primary[0]} {ARROW}</a><a class="btn btn-ghost btn-xl" href="{secondary[1]}" data-magnetic>{secondary[0]}</a></div>
    </div>
  </div>
</section>'''

PAGES = []  # (path, priority)

def page(path, title, desc, body, active=None, ld=None, catalog=False, og_image=None, robots=None, crumbs=None, lang="en", intro=False):
    """Write one page. path like '/playgrounds/' or '/404.html'."""
    url = BASE + path
    graph = [ORG] + (ld or [])
    if crumbs: graph.append(crumbs_ld(crumbs))
    ldjson = json.dumps({"@context": "https://schema.org", "@graph": graph}, ensure_ascii=False).replace("</", "<\\/")
    img = BASE + (og_image or "/og/dupedia-og.jpg")
    rob = robots or ("noindex, nofollow" if REVIEW else "index, follow, max-image-preview:large")
    cfg = {"formEndpoint": CFG.get("formEndpoint") or "", "email": CFG["contact"].get("email") or "", "whatsapp": CFG["contact"].get("whatsapp") or ""}
    full_title = title if "Dupedia" in title else f"{title} · Dupedia"
    doc = f'''<!doctype html>
<html lang="{lang}" dir="{"rtl" if lang == "ar" else "ltr"}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{e(full_title)}</title>
<meta name="description" content="{e(desc)}">
<link rel="canonical" href="{url}">
<meta name="robots" content="{rob}">
<meta name="theme-color" content="#1B1B19">
<meta property="og:type" content="{"product" if "/playgrounds/sw-" in path else "website"}">
<meta property="og:site_name" content="Dupedia">
<meta property="og:locale" content="en_EG">
<meta property="og:title" content="{e(full_title)}">
<meta property="og:description" content="{e(desc)}">
<meta property="og:url" content="{url}">
<meta property="og:image" content="{img}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{FONTS}">
<link rel="stylesheet" href="{FONT_SIG}">
<link rel="stylesheet" href="/assets/site.css?v={CSS_V}">
<script>document.documentElement.classList.add("js");window.DP_CONFIG={json.dumps(cfg)};{INTRO_JS if intro else ""}</script>
{'<script src="/assets/catalog.js?v=' + CAT_V + '" defer></script>' if catalog else ""}
<script src="/assets/site.js?v={JS_V}" defer></script>
<script src="/assets/motion.js?v={MO_V}" defer></script>
<script type="application/ld+json">{ldjson}</script>
</head>
<body>
{LOADER_HTML if intro else ""}{header(active)}
<main id="main">
{body}
</main>
{footer()}
</body>
</html>
'''
    dest = OUT / (path.lstrip("/") + ("index.html" if path.endswith("/") else ""))
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(doc)
    if robots is None: PAGES.append(path)

# ------------------------------------------------------------------ components
def product_card(p, lazy=True, heading="h3"):
    c = p["code"].lower()
    new = '<span class="tag">New 2026</span>' if p.get("isNew") else ""
    if p["thumb"]:
        media = (f'<img src="{p["thumb"]}" srcset="{p["thumb"]} 560w, {p["img"]} 1100w" sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 30vw" '
                 f'width="560" height="350" {LAZY if lazy else ""}decoding="async" alt="{e(p["name"])} ({p["code"]}), product visual" style="view-transition-name:pv-{c}">')
    else:
        media = '<span class="noimg">Photograph to follow</span>'
    return f'''<li class="card" data-code="{p["code"]}" data-coll="{p["collection"]}">
  <a href="{p["url"]}">
    <span class="media">{media}{new}</span>
    <span class="body">
      <span class="code">{p["code"]} · {e(CBY[p["collection"]]["short"])}</span>
      <{heading} class="nm">{e(p["name"])}</{heading}>
      <span class="meta"><span>{nb(p["dimensions"])}</span><span>{e(p["age"])}</span></span>
      <span class="fitflag" hidden></span>
    </span>
  </a>
  <button class="sl-btn" type="button" data-sl="{p["code"]}" data-name="{e(p["name"])}" aria-pressed="false" aria-label="Add {e(p["name"])} to shortlist">{ic("plus")}</button>
</li>'''

def phero(eyebrow, title, lede, crumbs=None, actions="", corner="var(--lime)"):
    cr = ""
    if crumbs:
        cr = '<nav aria-label="Breadcrumb"><ol class="crumbs">' + "".join(
            f'<li><a href="{u}">{n}</a></li>' if i < len(crumbs) - 1 else f'<li aria-current="page">{n}</li>' for i, (n, u) in enumerate(crumbs)) + "</ol></nav>"
    return f'''<section class="phero">
  <span class="corner-mark sweep" style="--c:{corner}" aria-hidden="true"></span>
  <div class="wrap">
    {cr}
    <p class="eyebrow">{eyebrow}</p>
    {hline(title)}
    <p class="lede">{lede}</p>
    {f'<div class="phero-act">{actions}</div>' if actions else ""}
  </div>
</section>'''

# ------------------------------------------------------------------ data-derived facts
Y301 = BY["SW-Y301"]
_dz = zone_of(Y301); _dd = dims_of(Y301)
Y_FOOT, Y_ZONE = _dd[0] * _dd[1], _dz[1] * _dz[2]
Y_RATIO = Y_ZONE / Y_FOOT   # 43.2 / 5.56 = 7.8

def coll_stats():
    rows = []
    for c in COLL:
        ps = [p for p in P if p["collection"] == c["key"]]
        rect = [(p, zone_of(p), dims_of(p)) for p in ps]
        rect = [(p, z, d) for p, z, d in rect if z[0] == "rect" and d and z[1] * z[2] >= d[0] * d[1]]  # skip zones smaller than the footprint (source data to confirm)
        if not rect: continue
        ratios = [z[1] * z[2] / (d[0] * d[1]) for p, z, d in rect]
        small = min(rect, key=lambda x: x[1][1] * x[1][2]); large = max(rect, key=lambda x: x[1][1] * x[1][2])
        rows.append((c, len(ps), len(rect), small, large, statistics.median(ratios)))
    return rows
_excl = [p for p in P if zone_of(p)[0] == "rect" and dims_of(p) and zone_of(p)[1] * zone_of(p)[2] < dims_of(p)[0] * dims_of(p)[1]]
EXCL_NOTE = ('<p class="source-note" style="margin-top:14px">Left out: ' + "; ".join(f'{e(p["name"])} ({p["code"]})' for p in _excl) +
             '. The published zone is smaller than the published footprint, so the figures need confirming with the manufacturer.</p>') if _excl else ""
ZKIND = {"rect": 0, "area": 0, "plan": 0}
for p in P: ZKIND[zone_of(p)[0]] += 1

# ------------------------------------------------------------------ pages

def clients_band(title_id="cl-t"):
    """Two rows of client names moving in opposite directions. Names as published on soliwood.org (7 Nov 2026)."""
    names = D.get("clients") or []
    if not names: return ""
    if CFG.get("clientsCredit") == "dupedia":
        eyebrow, title = "Clients", "Trusted at Egypt’s landmark <em>addresses.</em>"
        note = ""
    else:
        eyebrow, title = "Our outdoor range, already in place", "Built by Soliwood for Egypt’s landmark <em>addresses.</em>"
        note = '<p class="source-note" style="margin-top:20px">Clients of Soliwood, the Cairo manufacturer of our outdoor playground range, as listed on soliwood.org.</p>'
    half = (len(names) + 1) // 2
    def row(ns, rev):
        one = "".join(f'<span>{e(n)}<i class="mk" style="border-radius:{["0","100% 0 0 0","50%","999px 999px 0 0"][k % 4]}"></i></span>' for k, n in enumerate(ns))
        return f'<div class="marquee-track" data-rev="{1 if rev else 0}">{one * 4}</div>'
    return f'''<section class="clients" aria-labelledby="{title_id}">
  <div class="wrap"><p class="eyebrow dot" data-reveal>{eyebrow}</p><h2 class="h3" id="{title_id}" data-reveal style="margin-top:14px">{title}</h2></div>
  <div class="clients-rows" aria-hidden="true">{row(names[:half], False)}{row(names[half:], True)}</div>
  <ul class="sr">{"".join(f"<li>{e(n)}</li>" for n in names)}</ul>
  <div class="wrap">{note}</div>
</section>'''


def swing_section():
    """Editorial photo hung like a swing: it rocks with scroll and when the pointer pushes it (motion.js)."""
    return f'''<section class="sec swing" aria-labelledby="sw-t">
  <span class="swing-ball" aria-hidden="true"></span>
  <div class="wrap swing-grid">
    <div class="swing-copy">
      <p class="eyebrow dot" data-reveal>Why we do it</p>
      <h2 class="h1" id="sw-t" data-reveal style="margin-top:20px">Every size, code and safety zone we publish is for <em>this.</em></h2>
      <p class="lede" data-reveal style="margin-top:24px">The measuring, the drawings and the checks happen so that, on opening day, the only thing anyone notices is the play.</p>
      <div class="phero-act" data-reveal><a class="btn" href="/contact/" data-magnetic>Start your project {ARROW}</a><a class="link" href="/playgrounds/">See the swings and towers {ARROW}</a></div>
    </div>
    <div class="swing-stage" data-cursor="Push">
      <div class="swing-rig">
        <span class="rope l" aria-hidden="true"></span><span class="rope r" aria-hidden="true"></span>
        <figure class="swing-photo"><img src="/img/home-swings.jpg" srcset="/img/home-swings-480.jpg 404w, /img/home-swings.jpg 735w, /img/home-swings-1470.jpg 1470w" sizes="(max-width: 900px) 86vw, 40vw" width="1470" height="1744" loading="lazy" decoding="async" alt="Black-and-white photograph of two laughing girls on rope swings in a city courtyard."></figure>
      </div>
    </div>
  </div>
</section>'''

DIV_IMG = {
    "play": ("/img/div-playgrounds.webp", 1024, 1024, "A child climbing a wooden play tower with a green slide and swings on a lawn."),
    "soft": ("/img/div-soft-play.webp", 701, 438, "An indoor soft play centre with slides, a ball pit and neon-lit climbing frames."),
    "arcade": ("/img/div-arcades.webp", 768, 1024, "A family entertainment centre with brightly lit arcade and prize machines."),
    "water": ("/img/div-water-parks.webp", 452, 678, "A water play structure with slides and a splash pool at a resort water park."),
    "amuse": ("/img/div-amusement.webp", 1400, 935, "A swing ride lit up at dusk in an amusement park."),
}
def div_img(k, sizes="40vw", cls=""):
    src, w, h, alt = DIV_IMG[k]
    return f'<img src="{src}" width="{w}" height="{h}" sizes="{sizes}" alt="{alt}" loading="lazy" decoding="async"{(" class=" + chr(34) + cls + chr(34)) if cls else ""}>'

PLAY_BLOCKS = [("square", "var(--cream)", "0"), ("quarter", "var(--lime)", "100% 0 0 0"), ("circle", "var(--coral)", "50%"),
               ("square", "var(--sun)", "0"), ("half", "var(--lagoon)", "999px 999px 0 0"), ("half", "var(--iris)", "999px 999px 0 0"),
               ("circle", "var(--lime)", "50%"), ("half", "var(--cream)", "0 0 999px 999px"), ("quarter", "var(--cream)", "100% 0 0 0"), ("square", "var(--lime)", "0")]

def words(segments):
    """[(text, is_accent)] -> spans per word for the scroll-lit statement."""
    out = []
    for text, accent in segments:
        w = " ".join(f'<span class="w">{x}</span>' for x in text.split())
        out.append(f"<em>{w}</em>" if accent else w)
    return " ".join(out)

def ecosystem_section():
