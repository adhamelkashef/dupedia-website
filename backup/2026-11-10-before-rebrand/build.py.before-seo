    <ol class="steps">{PROCESS_HTML}</ol>
  </div>
</section>'''

    PREV = {"developers": "SW-E104", "hotels": "SW-E107", "schools": "SW-Y302", "municipalities": "SW-T212"}
    IMGATTR = lambda sid: f' data-img="{BY[PREV[sid]]["thumb"]}"' if sid in PREV else ""
    sectors = "".join(f'<li data-reveal style="--rd:{i}"><a class="ind" href="/who-we-work-with/#{s[0]}"{IMGATTR(s[0])}><span class="ind-name">{s[1]}</span><span class="ind-text">{s[2]}</span><span class="ind-go" aria-hidden="true">{ARROW}</span></a></li>' for i, s in enumerate(SECTORS))
    who = f'''<section class="sec" aria-labelledby="ind-t">
  <div class="wrap">
    <div class="sec-head"><div><p class="eyebrow dot" data-reveal>Who we work with</p><h2 class="h2" id="ind-t" data-reveal>Built for the people who <em>commission</em> play.</h2></div><p data-reveal>Each kind of client needs something different from a play space. Choose yours to see where projects usually start.</p></div>
    <ul class="ind-list">{sectors}</ul>
  </div>
</section>'''


    body = hero + marquee + clients_band() + ceo_note() + divisions + swing_section() + fit + xforce_intro() + insight + process + factory_teaser() + who + ecosystem_section() + cta_band()
    ld = [{"@type": "WebSite", "@id": BASE + "/#web", "url": BASE + "/", "name": "Dupedia", "publisher": {"@id": BASE + "/#org"}, "inLanguage": "en"}]
    page("/", "Dupedia · Playground design, supply and installation in Egypt",
         f"Dupedia designs, supplies and installs playgrounds, soft play, arcades, water parks and amusement attractions in Egypt, since 1989. Check which of {COUNT} playground products fit your site.",
         body, active="/", ld=ld, catalog=True, intro=True)

PROCESS = [
    ("Brief", "Your site, your users, your budget and your timing. A site plan, or a few photos with rough measurements, is enough to start."),
    ("Design", "We measure first, then draw a layout that keeps every published safety zone clear, and agree it with you."),
    ("Supply", "Products and finishes exactly as specified, each with a code you can check against the drawing."),
    ("Installation", "Assembly on site and handover of the finished space."),
]
PROCESS_HTML = "".join(f'<li data-reveal><span class="n">{n}</span><h3 class="h3">{n}</h3><p>{t}</p></li>' for n, t in PROCESS)
PROCESS_HTML = "".join(f'<li data-reveal><span class="n"></span><h3 class="h3">{n}</h3><p>{t}</p></li>' for n, t in PROCESS)

SECTORS = [
 ("developers", "Real estate developers", "Landmark play landscapes for master-planned communities.", ["estate", "tower", "landscape"], "Real estate developer",
  "Play is one of the first amenities residents use. We plan it with the masterplan: areas set aside for play, phase timing, and layouts your consultants can check.",
  ["Project name, location and phase timing", "The areas set aside for play, as a plan (PDF or DXF)", "Who the spaces are for: age groups and rough numbers"]),
 ("hotels", "Hotels &amp; resorts", "Signature play areas and matching site furniture.", ["estate", "landscape"], "Hotel or resort",
  "A kids’ area that sits well in the landscape and stands up to sun, sand and constant use, with benches in the same design language.",
  ["Property and location", "The available area and where guests approach it from", "Opening or refurbishment date"]),
 ("schools", "Schools &amp; universities", "Early-years playhouses, climbing and agility.", ["early", "adventure"], "School or university",
  "Age-appropriate equipment that fits the yard you actually have, with every safety zone drawn before anything is ordered.",
  ["Yard dimensions or a site plan", "Age groups, and roughly how many children play at once", "Term dates that limit installation"]),
