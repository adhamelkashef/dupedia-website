    ages = "".join(f'<button type="button" data-age="{a}" aria-pressed="{"true" if a == 0 else "false"}">{"Any age" if a == 0 else f"Age {a}"}</button>' for a in (0, 3, 5, 8, 12))
    fit = f'''<section class="sec sec-white" id="fit" aria-labelledby="fit-t">
